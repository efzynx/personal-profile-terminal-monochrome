# ----------------------------------------------------
# SINGLE ASTRO APP ENVIRONMENT VARIABLES
# ----------------------------------------------------

# --- LOCAL DEVELOPMENT PORT ---
PORT=4321

# --- GITHUB OAUTH & WRITER CMS CONFIGURATION ---
# Buat OAuth App di: https://github.com/settings/developers
# Callback URL: http://localhost:4321/api/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_ALLOWED_USER=efzynx
GITHUB_REPO_OWNER=efzynx
GITHUB_REPO_NAME=personal-profile-terminal-monochrome
SESSION_SECRET=super_secret_session_key_min_32_chars

# --- GITHUB API PERSONAL ACCESS TOKEN ---
# Digunakan untuk bypass Rate Limit (60 req/jam -> 5000 req/jam) & commit fallback
# Buat token di: https://github.com/settings/tokens (scope: public_repo & repo)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
