# ----------------------------------------------------
# SINGLE ASTRO APP ENVIRONMENT VARIABLES
# ----------------------------------------------------

# --- LOCAL DEVELOPMENT PORT ---
PORT=4321

# --- PUBLIC DOMAIN & ALLOWED HOSTS CONFIGURATION ---
PUBLIC_SITE_URL=https://your-custom-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,your-custom-domain.com

# --- GITHUB OAUTH & WRITER CMS CONFIGURATION ---
# Buat OAuth App di: https://github.com/settings/developers
# Callback URL (Dev): http://localhost:4321/api/auth/callback
# Callback URL (Prod): https://your-custom-domain.com/api/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_ALLOWED_USER=efzynx
GITHUB_REPO_OWNER=efzynx
GITHUB_REPO_NAME=personal-profile-terminal-monochrome
SESSION_SECRET=super_secret_session_key_min_32_chars

# --- GITHUB API PERSONAL ACCESS TOKEN ---
# Digunakan untuk bypass Rate Limit (60 req/jam -> 5000 req/jam) & commit fallback
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SUPABASE DATABASE CONFIGURATION ---
# Buat Proyek Supabase di: https://supabase.com
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
