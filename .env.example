# ----------------------------------------------------
# MONOREPO ENVIRONMENT VARIABLES (Single Source of Truth)
# ----------------------------------------------------

# --- LOCAL DEVELOPMENT PORTS ---
# Digunakan oleh Vite Server saat menjalankan pnpm dev di masing-masing app
APP_HOME_PORT=4321
APP_PORTFOLIO_PORT=4322
APP_BLOG_PORT=4323
APP_WRITER_PORT=4324

# --- PUBLIC APP BASE PATHS ---
# Base path Astro router saat dijalankan baik lokal maupun production
PUBLIC_HOME_BASE_PATH=/
PUBLIC_PORTFOLIO_BASE_PATH=/portfolio
PUBLIC_BLOG_BASE_PATH=/blog
PUBLIC_WRITER_BASE_PATH=/writer

# --- PUBLIC LOCAL APP URLs ---
# Digunakan untuk Cross-App Navigation saat mode DEV (local link antar project)
PUBLIC_HOME_URL=http://localhost:4321
PUBLIC_PORTFOLIO_URL=http://localhost:4322
PUBLIC_BLOG_URL=http://localhost:4323
PUBLIC_WRITER_URL=http://localhost:4324

# --- VERCEL UPSTREAM DEPLOYMENT URLs ---
# URL dari Vercel Project masing-masing app (dipakai untuk proxy/rewrite pada Root Gateway)
# Wajib diset di Vercel Dashboard project Home milikmu!
PORTFOLIO_UPSTREAM_URL=https://big3-portfolio.vercel.app
BLOG_UPSTREAM_URL=https://big3-blog.vercel.app
WRITER_UPSTREAM_URL=https://big3-writer.vercel.app

# --- GITHUB API TOKEN (Opsional tapi sangat direkomendasikan) ---
# Tanpa token: rate limit 60 req/jam
# Dengan token: rate limit 5000 req/jam
# Buat token di: https://github.com/settings/tokens (scope: public_repo saja cukup)
# JANGAN commit value aslinya ke git! Gunakan .env.local untuk local dev atau Vercel Environment Variables.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
