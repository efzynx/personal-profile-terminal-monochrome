---
/**
 * BaseLayout.astro — Shared layout for all apps
 * packages/ui/src/layouts/BaseLayout.astro
 *
 * Props:
 *   title        — Page <title> text
 *   description  — Meta description
 *   breadcrumb   — e.g. "cd ~/blog"  (shown after the prompt)
 *   showFooter   — Show prev/next pagination footer (default false)
 *   backHref     — Optional: href for back button (cd ..)
 *   backLabel    — Optional: label for back button (default "cd ..")
 */
interface Props {
    title: string;
    description?: string;
    breadcrumb?: string;
    showFooter?: boolean;
    backHref?: string;
    backLabel?: string;
}

const {
    title,
    description = "Ahmad Fauzan Adiman — Backend Developer & DevOps Enthusiast",
    breadcrumb = "cd ~/",
    showFooter = false,
    backHref,
    backLabel = "cd ..",
} = Astro.props;
---

<!doctype html>
<html class="dark" lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title} — Ahmad Fauzan Adiman</title>

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.BASE_URL}favicon.svg`}
        />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500&family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap"
            rel="stylesheet"
        />

        <!-- Tailwind CDN -->
        <script
            is:inline
            src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
        ></script>
        <script is:inline id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            primary: "#FFFFFF",
                            background: "#000000",
                            surface: "#0A0A0A",
                            text: "#E0E0E0",
                            muted: "#444444",
                            accent: "#888888",
                        },
                        fontFamily: {
                            mono: ["JetBrains Mono", "monospace"],
                            sans: ["IBM Plex Sans", "sans-serif"],
                        },
                        borderRadius: {
                            DEFAULT: "0px",
                            lg: "0px",
                            xl: "0px",
                            full: "0px",
                        },
                    },
                },
            };
        </script>

        <style is:global>
            /* Base */
            body {
                background-color: #000000;
                color: #e0e0e0;
                font-family: "IBM Plex Sans", sans-serif;
            }

            /* Terminal hover */
            .terminal-hover:hover {
                background-color: #0a0a0a;
            }
            .terminal-hover:hover .title-text::before {
                content: "* ";
                color: #ffffff;
            }

            /* Links */
            a {
                text-decoration: none;
                cursor: crosshair;
                transition: color 0ms;
            }
        </style>
    </head>
    <body
        class="min-h-screen bg-background text-text flex justify-center py-10 px-4 md:px-8 lg:px-12"
    >
        <div class="w-full max-w-7xl flex flex-col gap-8">
            <!-- Top Nav / Breadcrumb -->
            <nav class="flex items-center gap-2 font-mono text-sm text-accent">
                <span class="material-symbols-outlined text-[16px] text-primary"
                    >terminal</span
                >
                <a
                    href={import.meta.env.PUBLIC_HOME_URL ||
                        (import.meta.env.DEV ? "http://localhost:4321" : "/")}
                    class="hover:text-primary transition-colors duration-0 cursor-[crosshair]"
                    title="Return to Gateway Home">fauzan@tux:~$</a
                >
                <span class="text-primary">{breadcrumb}</span>
            </nav>

            <!-- Main content -->
            <main class="flex flex-col gap-4">
                <slot />
            </main>

            <!-- Back link (cd ..) — always at the bottom -->
            {backHref && (
                <div class="font-mono text-sm border-t border-dashed border-muted pt-4">
                    <a
                        href={backHref}
                        class="text-accent hover:text-primary transition-colors duration-0 cursor-[crosshair]"
                    >
                        &lt;- {backLabel}
                    </a>
                </div>
            )}

            <!-- Optional pagination footer -->
            {
                showFooter && (
                    <footer class="flex justify-between items-center py-6 font-mono text-sm font-semibold">
                        <slot name="footer-prev">
                            <span class="text-muted">[Prev]</span>
                        </slot>
                        <div class="text-muted text-xs">
                            <slot name="footer-page">PAGE 1/1</slot>
                        </div>
                        <slot name="footer-next">
                            <span class="text-muted">[Next]</span>
                        </slot>
                    </footer>
                )
            }
        </div>
    </body>
</html>
