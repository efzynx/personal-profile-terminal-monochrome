---
import { getCollection, render } from "astro:content";
import BaseLayout from "@repo/ui/layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts", ({ data }) => !data.draft);
    return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
    return d.toISOString().slice(0, 10);
}

// Estimate read time (~200 words/min)
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    breadcrumb={`cd ~/blog/${post.id}`}
    backHref={import.meta.env.BASE_URL}
    backLabel="cd ~/blog"
>
    <!-- Article header -->
    <header class="border-b border-muted pb-6">
        <div class="flex flex-wrap items-center gap-3 font-mono text-sm text-accent mb-4">
            <span>&gt; date: {formatDate(post.data.pubDate)}</span>
            <span class="text-muted">|</span>
            <span>&gt; author: fauzan</span>
            <span class="text-muted">|</span>
            <span>&gt; read_time: {readTime}m</span>
        </div>
        <h1 class="font-mono text-2xl md:text-3xl font-bold text-primary leading-tight mb-4">
            {post.data.title}
        </h1>
        <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
                <span class="border border-muted bg-surface font-mono text-xs text-text px-2 py-1">
                    [{tag}]
                </span>
            ))}
        </div>
    </header>

    <!-- Article body -->
    <article class="article-content font-sans text-base text-text leading-relaxed">
        <Content />
    </article>

    <!-- Footer -->
    <footer class="border-t border-muted pt-6 font-mono text-sm text-accent flex justify-between items-center">
        <span>EOF</span>
        <div class="flex gap-4">
            <a href={import.meta.env.BASE_URL} class="hover:text-primary transition-colors duration-0 cursor-[crosshair]">[Back]</a>
            <a href="#" class="hover:text-primary transition-colors duration-0 cursor-[crosshair]">[Top ↑]</a>
        </div>
    </footer>
</BaseLayout>

<style>
    .article-content p { margin-bottom: 1.25rem; line-height: 1.75; }
    .article-content h2 {
        font-family: "JetBrains Mono", monospace;
        font-size: 1.25rem; font-weight: 700; color: #FFFFFF;
        margin-top: 2rem; margin-bottom: 0.75rem;
        border-left: 2px solid #FFFFFF; padding-left: 0.75rem;
    }
    .article-content h3 {
        font-family: "JetBrains Mono", monospace;
        font-size: 1.1rem; font-weight: 600; color: #E0E0E0;
        margin-top: 1.5rem; margin-bottom: 0.5rem;
    }
    .article-content ul, .article-content ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
    .article-content li { margin-bottom: 0.4rem; line-height: 1.7; }
    .article-content a { color: #FFFFFF; border-bottom: 1px dashed #888888; }
    .article-content a:hover { border-color: #FFFFFF; }
    .article-content code {
        font-family: "JetBrains Mono", monospace; font-size: 0.875em;
        background-color: #0A0A0A; border: 1px solid #444444;
        padding: 0.1rem 0.35rem; color: #E0E0E0;
    }
    .article-content pre {
        background-color: #0A0A0A; border: 1px solid #444444;
        padding: 1rem; overflow-x: auto; margin-bottom: 1.25rem;
    }
    .article-content pre code { border: none; padding: 0; background: transparent; font-size: 0.875rem; }
    .article-content blockquote { border-left: 2px solid #444444; padding-left: 1rem; color: #888888; margin: 1.25rem 0; }
    .article-content img { max-width: 100%; height: auto; border: 1px solid #444444; margin: 1.5rem 0; display: block; }
    .article-content video { max-width: 100%; height: auto; margin: 1.5rem 0; }
</style>
