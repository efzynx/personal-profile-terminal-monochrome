---
// Writer login page — static UI only, no backend auth
// Use AGENTS.md monochrome palette
---

<!doctype html>
<html class="dark" lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Writer — Ahmad Fauzan Adiman</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400&family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap"
        rel="stylesheet"
    />

    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script is:inline id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary:    "#FFFFFF",
                        background: "#000000",
                        surface:    "#0A0A0A",
                        text:       "#E0E0E0",
                        muted:      "#444444",
                        accent:     "#888888",
                    },
                    fontFamily: {
                        mono: ["JetBrains Mono", "monospace"],
                        sans: ["IBM Plex Sans", "sans-serif"],
                    },
                    borderRadius: {
                        DEFAULT: "0px", lg: "0px", xl: "0px", full: "0px",
                    },
                },
            },
        };
    </script>
    <style is:global>
        body {
            background-color: #000000;
            color: #E0E0E0;
            font-family: "JetBrains Mono", monospace;
        }
        /* Autofill override */
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0 30px #0A0A0A inset !important;
            -webkit-text-fill-color: #E0E0E0 !important;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center px-4">
    <main class="w-full max-w-sm flex flex-col items-center gap-8">

        <!-- Terminal header bar -->
        <div class="w-full flex justify-between text-accent font-mono text-xs uppercase tracking-widest border-b border-muted pb-2">
            <span>&gt; auth_module_v1.0</span>
            <span>status: locked</span>
        </div>

        <!-- Login box -->
        <div class="w-full bg-surface border border-muted p-8 flex flex-col items-center gap-6">

            <!-- Title -->
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-xl">lock</span>
                <h1 class="font-mono text-base font-bold text-text uppercase tracking-wide">System Auth</h1>
            </div>

            <!-- Form -->
            <form
                id="login-form"
                class="w-full flex flex-col items-center gap-5"
                method="POST"
                action={import.meta.env.BASE_URL + "api/login"}
            >
                <!-- Username -->
                <div class="w-full flex items-end gap-3 relative group">
                    <label for="username" class="font-mono text-sm text-accent shrink-0 pb-2">user:</label>
                    <input
                        id="username"
                        name="username"
                        type="text"
                        autocomplete="username"
                        spellcheck="false"
                        required
                        class="flex-1 bg-transparent border-0 border-b border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-0 py-2 h-10 transition-colors duration-0 peer"
                    />
                    <span class="absolute right-0 bottom-2 text-primary opacity-0 peer-focus:opacity-100 font-mono animate-pulse">_</span>
                </div>

                <!-- Password -->
                <div class="w-full flex items-end gap-3 relative group">
                    <label for="password" class="font-mono text-sm text-accent shrink-0 pb-2">pass:</label>
                    <input
                        id="password"
                        name="password"
                        type="password"
                        autocomplete="current-password"
                        required
                        class="flex-1 bg-transparent border-0 border-b border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-0 py-2 h-10 tracking-widest transition-colors duration-0 peer"
                    />
                    <span class="absolute right-0 bottom-2 text-primary opacity-0 peer-focus:opacity-100 font-mono animate-pulse">_</span>
                </div>

                <!-- Submit -->
                <button
                    id="btn-login"
                    type="submit"
                    class="mt-4 w-full font-mono text-sm font-bold text-text hover:text-primary border border-muted hover:border-primary bg-transparent hover:bg-surface px-6 py-3 transition-colors duration-0 cursor-[crosshair] flex items-center justify-center gap-2"
                >
                    <span>[ EXECUTE ]</span>
                    <span class="material-symbols-outlined text-base opacity-0 group-hover:opacity-100">terminal</span>
                </button>
            </form>
        </div>

        <!-- Back link -->
        <a
            href="/"
            class="font-mono text-xs text-accent hover:text-text transition-colors duration-0 cursor-[crosshair] flex items-center gap-2"
        >
            &lt;-- cd ..
        </a>
    </main>
</body>
</html>
