---
import BaseLayout from "@repo/ui/layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const token = import.meta.env.GITHUB_TOKEN;
    const headers: Record<string, string> = { Accept: "application/vnd.github.v3+json" };
    if (token) headers["Authorization"] = `Bearer ${token}`;

    try {
        const res = await fetch(
            "https://api.github.com/users/efzynx/repos?sort=updated&per_page=4&type=public",
            { headers }
        );
        if (!res.ok) return [];
        const repos = await res.json();
        return repos.map((repo: { name: string }) => ({
            params: { repo: repo.name },
        }));
    } catch {
        return [];
    }
}

const { repo } = Astro.params;

interface RepoDetail {
    name: string;
    description: string | null;
    html_url: string;
    language: string | null;
    stargazers_count: number;
    forks_count: number;
    open_issues_count: number;
    default_branch: string;
    topics: string[];
    updated_at: string;
}

let repoData: RepoDetail | null = null;
let readmeHtml = "";
let fetchError = false;

const githubToken = import.meta.env.GITHUB_TOKEN;
const baseHeaders: Record<string, string> = {};
if (githubToken) {
    baseHeaders["Authorization"] = `Bearer ${githubToken}`;
}

try {
    const [repoRes, readmeRes] = await Promise.all([
        fetch(`https://api.github.com/repos/efzynx/${repo}`, {
            headers: { ...baseHeaders, Accept: "application/vnd.github.v3+json" },
        }),
        fetch(`https://api.github.com/repos/efzynx/${repo}/readme`, {
            headers: { ...baseHeaders, Accept: "application/vnd.github.html+json" },
        }),
    ]);

    if (repoRes.ok) {
        repoData = await repoRes.json();
    } else {
        fetchError = true;
    }

    if (readmeRes.ok) {
        readmeHtml = await readmeRes.text();
    } else {
        readmeHtml = "<p>README tidak tersedia untuk repository ini.</p>";
    }
} catch {
    fetchError = true;
}
---

<BaseLayout
    title={repoData ? `${repoData.name} — README` : `${repo} — README`}
    description={repoData?.description ?? `Repository ${repo} oleh efzynx`}
    breadcrumb={`cd ~/project/github/${repo}`}
    backHref="/project/github"
    backLabel="cd ~/project/github"
>
    {fetchError ? (
        <div class="font-mono text-sm text-muted border border-dashed border-muted px-4 py-6 text-center">
            <p class="text-accent mb-1">[ERROR]</p>
            <p>Gagal mengambil data repo. Coba lagi nanti.</p>
        </div>
    ) : repoData && (
        <>
            <!-- Repo Header -->
            <header class="border-b border-muted pb-4 flex flex-col gap-3">
                <div class="flex flex-col sm:flex-row sm:items-start gap-4 justify-between">
                    <div class="flex flex-col gap-2">
                        <h1 class="font-mono text-2xl md:text-3xl font-bold text-primary">
                            {repoData.name}
                        </h1>
                        {repoData.description && (
                            <p class="font-sans text-sm text-accent leading-relaxed">{repoData.description}</p>
                        )}
                    </div>
                    <!-- Visit Repository Button -->
                    <a
                        href={repoData.html_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0 self-start font-mono text-sm border border-muted px-4 py-2 text-accent hover:text-primary hover:border-primary transition-colors duration-0 cursor-[crosshair] whitespace-nowrap"
                    >
                        [↗ Kunjungi Repository]
                    </a>
                </div>

                <!-- Repo Stats -->
                <div class="flex flex-wrap gap-4 font-mono text-xs text-muted">
                    {repoData.language && (
                        <span>lang: <span class="text-accent">{repoData.language}</span></span>
                    )}
                    <span>★ <span class="text-accent">{repoData.stargazers_count}</span></span>
                    <span>forks: <span class="text-accent">{repoData.forks_count}</span></span>
                    <span>issues: <span class="text-accent">{repoData.open_issues_count}</span></span>
                    <span>branch: <span class="text-accent">{repoData.default_branch}</span></span>
                </div>

                {repoData.topics.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                        {repoData.topics.map(topic => (
                            <span class="font-mono text-xs text-muted border border-muted px-2 py-0.5">[{topic}]</span>
                        ))}
                    </div>
                )}
            </header>

            <!-- README Divider -->
            <div class="font-mono text-xs text-muted flex items-center gap-3">
                <span class="text-accent">cat</span>
                <span>README.md</span>
                <span class="flex-1 border-t border-dashed border-muted"></span>
            </div>

            <!-- README Content -->
            <article class="readme-content font-sans text-sm text-text leading-relaxed" set:html={readmeHtml} />
        </>
    )}
</BaseLayout>

<style is:global>
    /* README markdown styles — terminal editorial theme */
    .readme-content h1,
    .readme-content h2,
    .readme-content h3,
    .readme-content h4 {
        font-family: "JetBrains Mono", monospace;
        color: #FFFFFF;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        font-weight: 700;
        line-height: 1.3;
    }
    .readme-content h1 { font-size: 1.4rem; border-bottom: 1px solid #444444; padding-bottom: 0.4rem; }
    .readme-content h2 { font-size: 1.15rem; border-bottom: 1px dashed #444444; padding-bottom: 0.25rem; }
    .readme-content h3 { font-size: 1rem; }
    .readme-content h4 { font-size: 0.9rem; color: #888888; }

    .readme-content p { margin-bottom: 0.85rem; color: #E0E0E0; }

    .readme-content a {
        color: #888888;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .readme-content a:hover { color: #FFFFFF; }

    .readme-content code {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.8rem;
        background: #0A0A0A;
        border: 1px solid #444444;
        padding: 0.1rem 0.4rem;
        color: #E0E0E0;
    }
    .readme-content pre {
        background: #0A0A0A;
        border: 1px solid #444444;
        padding: 1rem;
        overflow-x: auto;
        margin: 1rem 0;
    }
    .readme-content pre code {
        border: none;
        padding: 0;
        background: transparent;
        font-size: 0.8rem;
        line-height: 1.6;
    }

    .readme-content ul,
    .readme-content ol {
        padding-left: 1.25rem;
        margin-bottom: 0.85rem;
        color: #E0E0E0;
    }
    .readme-content ul { list-style-type: disc; }
    .readme-content ol { list-style-type: decimal; }
    .readme-content li { margin-bottom: 0.3rem; }

    .readme-content blockquote {
        border-left: 2px solid #444444;
        padding-left: 1rem;
        color: #888888;
        margin: 1rem 0;
        font-style: italic;
    }

    .readme-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
        font-size: 0.85rem;
    }
    .readme-content th {
        font-family: "JetBrains Mono", monospace;
        border: 1px solid #444444;
        padding: 0.4rem 0.7rem;
        color: #FFFFFF;
        text-align: left;
        background: #0A0A0A;
    }
    .readme-content td {
        border: 1px solid #444444;
        padding: 0.4rem 0.7rem;
        color: #E0E0E0;
    }

    .readme-content hr {
        border: none;
        border-top: 1px dashed #444444;
        margin: 1.5rem 0;
    }

    .readme-content img {
        max-width: 100%;
        height: auto;
        border: 1px solid #444444;
        margin: 1rem 0;
        display: block;
    }
</style>
