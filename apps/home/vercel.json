{
  "rewrites": [
    {
      "source": "/portfolio/:path*",
      "destination": "https://big3-portfolio.vercel.app/portfolio/:path*"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://big3-blog.vercel.app/blog/:path*"
    },
    {
      "source": "/writer/:path*",
      "destination": "https://big3-writer.vercel.app/writer/:path*"
    }
  ]
}
