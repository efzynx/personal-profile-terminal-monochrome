---
/**
 * BaseLayout.astro — Single Unified App Layout
 * src/layouts/BaseLayout.astro
 *
 * Props:
 *   title        — Page <title> text
 *   description  — Meta description
 *   breadcrumb   — e.g. "cd ~/blog"
 *   showFooter   — Show prev/next pagination footer (default false)
 *   backHref     — Optional: href for back button (cd ..)
 *   backLabel    — Optional: label for back button (default "cd ..")
 */
interface Props {
    title: string;
    description?: string;
    breadcrumb?: string;
    showFooter?: boolean;
    backHref?: string;
    backLabel?: string;
    canonicalUrl?: string;
    ogType?: 'website' | 'article';
    ogImage?: string;
    articlePublishedTime?: string;
    articleAuthor?: string;
    articleTags?: string[];
    schemaJsonLd?: Record<string, any> | Array<Record<string, any>>;
    variant?: 'default' | 'article';
    noindex?: boolean;
}

const {
    title,
    description = "Ahmad Fauzan Adiman — Backend Developer & DevOps Enthusiast",
    breadcrumb = "cd ~/",
    showFooter = false,
    backHref,
    backLabel = "cd ..",
    canonicalUrl,
    ogType = 'website',
    ogImage,
    articlePublishedTime,
    articleAuthor,
    articleTags,
    schemaJsonLd,
    variant = 'default',
    noindex = false,
} = Astro.props;

import '../styles/global.css';
import { getProfileData } from "../lib/cms";
import TerminalModal from "../components/TerminalModal.astro";
import SEO from "../components/SEO.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

const profileData = await getProfileData();
const activeFavicon = profileData.faviconUrl || "/favicon.svg";
const activeAvatar = profileData.avatarUrl || "/saya.avif";

const fullTitle = title.includes('Ahmad Fauzan Adiman')
    ? title
    : `${title} — Ahmad Fauzan Adiman`;
---



<!doctype html>
<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{fullTitle}</title>

        <!-- Technical SEO, Open Graph & Schema.org JSON-LD -->
        <SEO
            title={title}
            description={description}
            canonicalUrl={canonicalUrl}
            ogType={ogType}
            ogImage={ogImage}
            articlePublishedTime={articlePublishedTime}
            articleAuthor={articleAuthor}
            articleTags={articleTags}
            schemaJsonLd={schemaJsonLd}
            faviconUrl={activeFavicon}
            avatarUrl={activeAvatar}
            noindex={noindex}
        />

        <!-- Web App Manifest (PWA) -->
        <link rel="manifest" href="/site.webmanifest" />

        <!-- RSS Feed Auto-Discovery -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Ahmad Fauzan Adiman — RSS Feed"
            href="https://www.efzyn.my.id/rss.xml"
        />

        <!-- Early Theme Initialization Script (Anti-FOUC) -->
        <script is:inline>
            (function () {
                var storedTheme = localStorage.getItem('theme') || 'system';
                var isDark =
                    storedTheme === 'dark' ||
                    (storedTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (isDark) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
        </script>

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500&display=swap"
            rel="stylesheet"
        />

        <style is:global>
            :root {
                --color-background: #ffffff;
                --color-surface: #f4f4f5;
                --color-border: #e5e5e5;
                --color-text: #18181b;
                --color-muted: #71717a;
                --color-accent: #52525b;
                --color-primary: #000000;

                --font-mono: "JetBrains Mono", monospace;
                --font-sans: "IBM Plex Sans", sans-serif;
            }

            html.dark {
                --color-background: #0a0a0a;
                --color-surface: #141414;
                --color-border: #2a2a2a;
                --color-text: #d4d4d4;
                --color-muted: #5a5a5a;
                --color-accent: #8a8a8a;
                --color-primary: #f0f0f0;
            }
        </style>
    </head>
    <body
        class:list={[
            "min-h-screen bg-background text-text flex justify-center pb-16 md:pb-24 px-5 sm:px-8 md:px-12 lg:px-16",
            variant === "article" ? "pt-4 sm:pt-6 md:pt-8" : "pt-8 sm:pt-12 md:pt-16 lg:pt-20",
        ]}
    >
        <div
            class:list={[
                "w-full max-w-7xl flex flex-col",
                variant === "article" ? "gap-4 sm:gap-6" : "gap-8",
            ]}
        >
            <!-- Top Nav / Breadcrumb & Theme Selector -->
            {variant === 'article' ? (
                <nav class="flex items-center justify-between font-mono text-xs">
                    <a
                        href={backHref || "/blog"}
                        class="inline-flex items-center gap-1.5 font-mono text-xs text-muted hover:text-primary transition-colors duration-0 cursor-[crosshair]"
                    >
                        &lt;- {backLabel || 'cd ..'}
                    </a>
                </nav>
            ) : (
                <nav class="flex flex-wrap items-center justify-between gap-4 font-mono text-sm">
                    <div class="flex items-center gap-2 text-accent">
                        <svg
                            class="w-4 h-4 text-primary shrink-0"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                            aria-hidden="true"
                        >
                            <polyline points="4 17 10 11 4 5"></polyline>
                            <line x1="12" y1="19" x2="20" y2="19"></line>
                        </svg>
                        <a
                            href="/"
                            class="hover:text-primary transition-colors duration-0 cursor-[crosshair]"
                            title="Return to Gateway Home">{profileData.terminalPrompt || 'fauzan@tux'}:~$</a
                        >

                        <span class="text-primary">{breadcrumb}</span>
                    </div>

                    <!-- Theme Selector -->
                    <ThemeToggle />
                </nav>
            )}

            <!-- Main content -->
            <main class="flex flex-col gap-4">
                <slot />
            </main>

            <!-- Back link & Footer -->
            {variant === 'article' ? (
                <footer class="font-mono text-xs text-muted border-t border-dashed border-muted pt-4 flex flex-wrap items-center justify-between gap-4">
                    <a
                        href={backHref || "/blog"}
                        class="text-accent hover:text-primary transition-colors duration-0 cursor-[crosshair]"
                    >
                        &lt;- {backLabel || 'cd ..'}
                    </a>

                    <!-- Theme Selector -->
                    <ThemeToggle />
                </footer>
            ) : (
                backHref && (
                    <div class="font-mono text-sm border-t border-dashed border-muted pt-4">
                        <a
                            href={backHref}
                            class="text-accent hover:text-primary transition-colors duration-0 cursor-[crosshair]"
                        >
                            &lt;- {backLabel}
                        </a>
                    </div>
                )
            )}

            <!-- Optional pagination footer -->
            {
                showFooter && (
                    <footer class="flex justify-between items-center py-6 font-mono text-sm font-semibold">
                        <slot name="footer-prev">
                            <span class="text-muted">[Prev]</span>
                        </slot>
                        <div class="text-muted text-xs">
                            <slot name="footer-page">PAGE 1/1</slot>
                        </div>
                        <slot name="footer-next">
                            <span class="text-muted">[Next]</span>
                        </slot>
                    </footer>
                )
            }
        </div>

        <TerminalModal />
    </body>
</html>