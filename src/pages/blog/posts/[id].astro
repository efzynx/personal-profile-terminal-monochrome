---
export const prerender = false;
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPost } from "../../../lib/cms";
import { formatDate, calculateReadTime } from "../../../lib/utils";
import { marked } from "marked";

const { id } = Astro.params;
const post = await getPost(id || "");

if (!post) {
    return Astro.redirect("/blog");
}

const readTime = calculateReadTime(post.content || "");
const htmlContent = marked.parse(post.content || "");
---

<BaseLayout
    title={post.frontmatter.title}
    description={post.frontmatter.description}
    breadcrumb={`cd ~/blog/${post.slug}`}
    backHref="/blog"
    backLabel="cd ~/blog"
>
    <!-- Article header -->
    <header class="border-b border-muted pb-6">
        <div class="flex flex-wrap items-center gap-3 font-mono text-sm text-accent mb-4">
            <span>&gt; date: {formatDate(post.frontmatter.pubDate)}</span>
            <span class="text-muted">|</span>
            <span>&gt; author: fauzan</span>
            <span class="text-muted">|</span>
            <span>&gt; read_time: {readTime}m</span>
        </div>
        <h1 class="font-mono text-2xl md:text-3xl font-bold text-primary leading-tight mb-4">
            {post.frontmatter.title}
        </h1>
        <div class="flex flex-wrap gap-2">
            {post.frontmatter.tags && post.frontmatter.tags.map((tag: string) => (
                <span class="border border-muted bg-surface font-mono text-xs text-text px-2 py-1">
                    [{tag}]
                </span>
            ))}
        </div>
    </header>

    <!-- Article body -->
    <article class="article-content font-sans text-base text-text leading-relaxed mt-6" set:html={htmlContent}>
    </article>

    <!-- Footer -->
    <footer class="border-t border-muted pt-6 font-mono text-sm text-accent flex justify-between items-center mt-8">
        <span>EOF</span>
        <div class="flex gap-4">
            <a href="/blog" class="hover:text-primary transition-colors duration-0 cursor-[crosshair]">[Back]</a>
            <a href="#" class="hover:text-primary transition-colors duration-0 cursor-[crosshair]">[Top ↑]</a>
        </div>
    </footer>
</BaseLayout>

<style>
    .article-content {
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .article-content p { margin-bottom: 1.25rem; line-height: 1.75; overflow-wrap: anywhere; word-break: break-word; }
    .article-content h2 {
        font-family: "JetBrains Mono", monospace;
        font-size: 1.25rem; font-weight: 700; color: var(--color-primary);
        margin-top: 2rem; margin-bottom: 0.75rem;
        border-left: 2px solid var(--color-primary); padding-left: 0.75rem;
    }
    .article-content h3 {
        font-family: "JetBrains Mono", monospace;
        font-size: 1.1rem; font-weight: 600; color: var(--color-text);
        margin-top: 1.5rem; margin-bottom: 0.5rem;
    }
    .article-content ul, .article-content ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
    .article-content li { margin-bottom: 0.4rem; line-height: 1.7; }
    .article-content a { color: var(--color-primary); border-bottom: 1px dashed var(--color-accent); }
    .article-content a:hover { border-color: var(--color-primary); }
    .article-content code {
        font-family: "JetBrains Mono", monospace; font-size: 0.875em;
        background-color: var(--color-surface); border: 1px solid var(--color-border);
        padding: 0.1rem 0.35rem; color: var(--color-text);
    }
    .article-content pre {
        background-color: var(--color-surface); border: 1px solid var(--color-border);
        padding: 1rem; overflow-x: auto; margin-bottom: 1.25rem;
    }
    .article-content pre code { border: none; padding: 0; background: transparent; font-size: 0.875rem; }
    .article-content blockquote { border-left: 2px solid var(--color-border); padding-left: 1rem; color: var(--color-accent); margin: 1.25rem 0; }
    .article-content img { max-width: 100%; height: auto; border: 1px solid var(--color-border); margin: 1.5rem 0; display: block; }
    .article-content video { max-width: 100%; height: auto; margin: 1.5rem 0; }
</style>
