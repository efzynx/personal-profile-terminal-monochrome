---
export const prerender = false;
import BaseLayout from "@layouts/BaseLayout.astro";
import { listPosts, getProfileData } from "../../lib/cms";
import { formatDate } from "../../lib/utils";

const profileData = await getProfileData();
const posts = await listPosts();

const username = profileData.terminalPrompt ? profileData.terminalPrompt.split('@')[0] : "user";
---

<BaseLayout
    title="Blog"
    description={`Catatan teknis ${profileData.name}`}
    breadcrumb="cd ~/blog"
    backHref="/"
    backLabel="cd ~/"
>
    <!-- Header -->
    <header class="border-b border-muted pb-4">
        <h1 class="font-mono text-2xl md:text-3xl font-bold text-primary">
            total {posts.length} posts
        </h1>
        <p class="font-mono text-sm text-accent mt-2">
            drwxr-xr-x {username} users 4096 . ~/blog
        </p>
    </header>


    <!-- Table header (desktop only) -->
    <div
        class="hidden md:grid grid-cols-[120px_120px_1fr] gap-4 px-4 py-2 font-mono text-sm font-bold border-b border-muted text-primary uppercase"
    >
        <div>Date</div>
        <div>Category</div>
        <div>Title</div>
    </div>

    <!-- Post list -->
    <div class="flex flex-col">
        {
            posts.length === 0 ? (
                <div class="py-12 flex justify-center border border-dashed border-muted">
                    <p class="font-mono text-sm text-accent">No posts found.</p>
                </div>
            ) : (
                posts.map((post) => (
                    <a
                        id={`post-${post.slug}`}
                        href={`/blog/posts/${post.slug}`}
                        class="terminal-hover group grid grid-cols-1 md:grid-cols-[120px_120px_1fr] gap-2 md:gap-4 px-4 py-4 md:py-3 border-b border-dashed border-muted transition-colors duration-0 no-underline cursor-[crosshair]"
                    >
                        <div class="font-mono text-sm text-accent self-center">
                            {formatDate(post.frontmatter.pubDate)}
                        </div>
                        <div class="font-mono text-sm text-muted self-center font-bold tracking-wider">
                            [{post.frontmatter.category}]
                        </div>
                        <div class="font-sans text-base text-text self-center title-text group-hover:text-primary transition-colors duration-0">
                            {post.frontmatter.title}
                        </div>
                    </a>
                ))
            )
        }
    </div>
</BaseLayout>
