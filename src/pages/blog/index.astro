---
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');

import BaseLayout from "@layouts/BaseLayout.astro";
import { listPosts, getProfileData } from "../../lib/cms";
import { formatDate, extractFirstImage } from "../../lib/utils";

const profileData = await getProfileData();
const posts = await listPosts();

const username = profileData.terminalPrompt ? profileData.terminalPrompt.split('@')[0] : "user";

// Ekstraksi kategori unik beserta hitungan artikel
const categoryCountMap = new Map<string, number>();
posts.forEach((post) => {
    const cat = post.frontmatter.category || 'General';
    categoryCountMap.set(cat, (categoryCountMap.get(cat) || 0) + 1);
});
const availableCategories = Array.from(categoryCountMap.keys()).sort((a, b) => a.localeCompare(b));

// Ekstraksi tag unik beserta hitungan artikel
const tagCountMap = new Map<string, number>();
posts.forEach((post) => {
    (post.frontmatter.tags || []).forEach((t: string) => {
        const lower = t.trim().toLowerCase();
        if (lower) {
            tagCountMap.set(lower, (tagCountMap.get(lower) || 0) + 1);
        }
    });
});
const availableTags = Array.from(tagCountMap.keys()).sort((a, b) => a.localeCompare(b));
---

<BaseLayout
    title="Blog"
    description={`Catatan teknis & tulisan ${profileData.name}`}
    breadcrumb="cd ~/blog"
    backHref="/"
    backLabel="cd ~/"
>
    <!-- Header -->
    <header class="mb-6">
        <p class="font-mono text-xs text-muted mb-1">&gt; cd ~/blog</p>
        <h1 class="font-mono text-2xl sm:text-3xl font-bold text-primary mb-1">
            Blog & Catatan Teknis — {profileData.name || "Ahmad Fauzan Adiman"} <span class="text-accent font-normal text-base sm:text-lg">({posts.length})</span>
        </h1>
        <p class="font-mono text-xs text-muted">
            drwxr-xr-x {username} users 4096 . ~/blog
        </p>
    </header>

    <!-- Search & Filter Toolbar -->
    <div class="flex flex-col gap-3 pb-3">
        <!-- Live Search Input -->
        <div class="relative w-full">
            <span class="absolute left-3 top-2.5 font-mono text-xs text-accent select-none">&gt; grep:</span>
            <input
                type="text"
                id="search-input"
                placeholder="Cari artikel berdasarkan judul, kategori, atau tag..."
                class="w-full bg-surface border border-muted hover:border-accent focus:border-primary focus:outline-none font-mono text-xs text-text pl-20 pr-4 py-2 transition-colors cursor-[crosshair]"
            />
        </div>

        <!-- Modular Dropdown Filter Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs py-2.5 px-3 bg-surface border border-muted">
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-primary font-bold flex items-center gap-1.5 select-none">
                    <span class="inline-block w-2 h-2 bg-primary"></span>
                    FILTER:
                </span>

                <!-- Dropdown Kategori -->
                <div class="flex items-center gap-1.5">
                    <label for="filter-category" class="text-accent select-none">&gt; category:</label>
                    <select
                        id="filter-category"
                        class="bg-background border border-muted hover:border-accent focus:border-primary focus:outline-none text-text text-xs px-2 py-1 font-mono cursor-[crosshair] transition-colors"
                    >
                        <option value="all">Semua Kategori ({posts.length})</option>
                        {availableCategories.map(cat => (
                            <option value={cat.toLowerCase()}>{cat} ({categoryCountMap.get(cat)})</option>
                        ))}
                    </select>
                </div>

                <!-- Dropdown Tag -->
                <div class="flex items-center gap-1.5">
                    <label for="filter-tag" class="text-accent select-none">&gt; tag:</label>
                    <select
                        id="filter-tag"
                        class="bg-background border border-muted hover:border-accent focus:border-primary focus:outline-none text-text text-xs px-2 py-1 font-mono cursor-[crosshair] transition-colors"
                    >
                        <option value="all">Semua Tag ({availableTags.length})</option>
                        {availableTags.map(tag => (
                            <option value={tag}>#{tag} ({tagCountMap.get(tag)})</option>
                        ))}
                    </select>
                </div>

                <!-- Tombol Reset -->
                <button
                    type="button"
                    id="btn-reset-filters"
                    class="hidden border border-muted hover:border-primary bg-background text-accent hover:text-primary px-2.5 py-1 text-xs font-mono cursor-[crosshair] transition-colors"
                    title="Reset semua filter"
                >
                    [ RESET ]
                </button>
            </div>

            <!-- Badge Counter -->
            <div class="text-muted font-mono text-[11px] self-center">
                <span id="filter-result-count" class="text-primary font-bold">{posts.length}</span> / {posts.length} items
            </div>
        </div>
    </div>

    <!-- Table header (desktop only) -->
    <div
        class="hidden md:grid grid-cols-[120px_120px_1fr] gap-4 px-4 py-2 font-mono text-xs font-bold border-b border-muted text-primary uppercase"
    >
        <div>Date</div>
        <div>Category</div>
        <div>Title & Description</div>
    </div>

    <!-- Post list -->
    <div id="posts-container" class="flex flex-col">
        {
            posts.length === 0 ? (
                <div class="py-12 flex justify-center border border-dashed border-muted">
                    <p class="font-mono text-xs text-accent">Belum ada artikel yang dipublikasikan.</p>
                </div>
            ) : (
                posts.map((post) => {
                    const catLower = (post.frontmatter.category || 'general').toLowerCase();
                    const tagsLower = (post.frontmatter.tags || []).map((t: string) => t.toLowerCase().trim()).filter(Boolean).join(' ');
                    const searchHaystack = `${post.frontmatter.title} ${post.frontmatter.description || ''} ${catLower} ${tagsLower}`.toLowerCase();
                    const explicitCover =
                        post.frontmatter.coverImage ||
                        (post.frontmatter as any).cover_image ||
                        (post.frontmatter as any).thumbnail ||
                        (post.frontmatter as any).image;
                    const contentImg = extractFirstImage(post.content);
                    const coverThumbnail = explicitCover || contentImg;
                    
                    return (
                        <a
                            id={`post-${post.slug}`}
                            href={`/blog/posts/${post.slug}`}
                            data-category={catLower}
                            data-tags={tagsLower}
                            data-search={searchHaystack}
                            class="post-row terminal-hover group grid grid-cols-1 md:grid-cols-[120px_120px_1fr] gap-2 md:gap-4 px-4 py-4 md:py-3 border-b border-dashed border-muted transition-colors duration-0 no-underline cursor-[crosshair]"
                        >
                            <div class="font-mono text-xs text-accent self-start md:self-center">
                                {formatDate(post.frontmatter.pubDate)}
                            </div>
                            <div class="font-mono text-xs text-muted self-start md:self-center font-bold tracking-wider">
                                [{post.frontmatter.category || 'General'}]
                            </div>
                            <div class="flex items-center gap-3.5 self-center min-w-0">
                                {coverThumbnail && (
                                    <div class="w-16 h-12 md:w-20 md:h-14 shrink-0 border border-muted overflow-hidden bg-background">
                                        <img
                                            src={coverThumbnail}
                                            alt={post.frontmatter.title}
                                            class="w-full h-full object-cover grayscale contrast-125 brightness-90 group-hover:grayscale-0 transition-all duration-200"
                                            loading="lazy"
                                        />
                                    </div>
                                )}
                                <div class="flex flex-col gap-1 min-w-0">
                                    <div class="font-sans text-base font-medium text-text title-text group-hover:text-primary transition-colors duration-0 line-clamp-2 md:line-clamp-1">
                                        {post.frontmatter.title}
                                    </div>
                                    {post.frontmatter.description && (
                                        <p class="font-sans text-xs text-accent line-clamp-1">
                                            {post.frontmatter.description}
                                        </p>
                                    )}
                                </div>
                            </div>
                        </a>
                    );
                })
            )
        }
    </div>

    <div id="no-results" class="hidden py-12 flex justify-center border border-dashed border-muted">
        <p class="font-mono text-xs text-accent">Tidak ada artikel yang cocok dengan kriteria filter.</p>
    </div>

    <!-- Client-Side Filter Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('search-input');
            const categorySelect = document.getElementById('filter-category');
            const tagSelect = document.getElementById('filter-tag');
            const btnReset = document.getElementById('btn-reset-filters');
            const countEl = document.getElementById('filter-result-count');
            const postRows = document.querySelectorAll('.post-row');
            const noResults = document.getElementById('no-results');

            function applyFilters() {
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const selectedCategory = categorySelect ? categorySelect.value : 'all';
                const selectedTag = tagSelect ? tagSelect.value : 'all';

                let visibleCount = 0;

                postRows.forEach((row) => {
                    const rowCat = row.getAttribute('data-category') || '';
                    const rowTags = (row.getAttribute('data-tags') || '').split(' ').filter(Boolean);
                    const rowSearch = row.getAttribute('data-search') || '';

                    const matchesSearch = !query || rowSearch.includes(query);
                    const matchesCategory = selectedCategory === 'all' || rowCat === selectedCategory;
                    const matchesTag = selectedTag === 'all' || rowTags.includes(selectedTag);

                    if (matchesSearch && matchesCategory && matchesTag) {
                        row.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        row.classList.add('hidden');
                    }
                });

                if (countEl) {
                    countEl.textContent = String(visibleCount);
                }

                if (noResults) {
                    noResults.classList.toggle('hidden', visibleCount > 0);
                }

                const isFiltered = query !== '' || selectedCategory !== 'all' || selectedTag !== 'all';
                if (btnReset) {
                    btnReset.classList.toggle('hidden', !isFiltered);
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', applyFilters);
            }

            if (categorySelect) {
                categorySelect.addEventListener('change', applyFilters);
            }

            if (tagSelect) {
                tagSelect.addEventListener('change', applyFilters);
            }

            if (btnReset) {
                btnReset.addEventListener('click', () => {
                    if (searchInput) searchInput.value = '';
                    if (categorySelect) categorySelect.value = 'all';
                    if (tagSelect) tagSelect.value = 'all';
                    applyFilters();
                });
            }
        });
    </script>
</BaseLayout>
