---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import { getSession } from "../../lib/auth";
import { getNewsItem } from "../../lib/news";
import { formatDate, calculateReadTime, extractFirstImage, isSafeForOgImage, stripFirstImage } from "../../lib/utils";
import { sanitizeArticleContent } from "../../lib/sanitize";
import { Marked } from "marked";

const session = getSession(Astro.cookies);
const { id } = Astro.params;
const item = await getNewsItem(id || "");

if (!item) {
    return Astro.redirect("/news");
}
if (item.draft && !session) {
    return Astro.redirect("/news");
}

if (item.draft) {
    Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, must-revalidate');
} else {
    Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
}

const rawContent = item.content || "";
const readTime = calculateReadTime(rawContent);

// Extract Headings for Table of Contents (TOC)
interface TocItem {
    depth: number;
    text: string;
    id: string;
}

const toc: TocItem[] = [];
const headingRegex = /^(#{2,3})\s+(.+)$/gm;
let match;
while ((match = headingRegex.exec(rawContent)) !== null) {
    const depth = match[1].length;
    const text = match[2].trim().replace(/[*_~`]/g, "");
    const slugId = text
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, "")
        .replace(/\s+/g, "-");
    toc.push({ depth, text, id: slugId });
}

// Configured marked parser with custom heading IDs & table wrappers
const markedInstance = new Marked();
markedInstance.use({
    renderer: {
        heading(token) {
            const text = token.text;
            const level = token.depth;
            const cleanText = text.replace(/<[^>]*>/g, "");
            const slugId = cleanText
                .toLowerCase()
                .replace(/[^a-z0-9\s-]/g, "")
                .replace(/\s+/g, "-");
            return `<h${level} id="${slugId}" class="scroll-mt-24">${text}</h${level}>`;
        },
        table(token) {
            let headerHtml = "";
            let bodyHtml = "";

            token.header.forEach((cell) => {
                headerHtml += `<th>${cell.text}</th>`;
            });
            token.rows.forEach((row) => {
                let rowHtml = "";
                row.forEach((cell) => {
                    rowHtml += `<td>${cell.text}</td>`;
                });
                bodyHtml += `<tr>${rowHtml}</tr>`;
            });

            return `<div class="table-container"><table class="markdown-table"><thead><tr>${headerHtml}</tr></thead><tbody>${bodyHtml}</tbody></table></div>`;
        },
        hr() {
            return `<hr class="terminal-hr" />`;
        },
    },
});

const siteBase = process.env.PUBLIC_SITE_URL && !process.env.PUBLIC_SITE_URL.includes('localhost')
    ? process.env.PUBLIC_SITE_URL.replace(/\/$/, '')
    : 'https://www.efzyn.my.id';

const pageUrl = `${siteBase}/news/${item.id}`;

// 1. Cek field cover image eksplisit (prioritaskan cover_image milik artikel)
const rawExplicitCover =
    item.cover_image ||
    item.coverImage ||
    (item as any).thumbnail ||
    (item as any).image;

const hasValidCover = typeof rawExplicitCover === 'string' && rawExplicitCover.trim() !== '';
const explicitCover = hasValidCover ? rawExplicitCover.trim() : undefined;

// 2. Ekstrak gambar pertama dari konten artikel/markdown jika tidak ada cover eksplisit
const rawContentImage = extractFirstImage(rawContent);
const safeContentImage = isSafeForOgImage(rawContentImage) ? rawContentImage : undefined;

const coverToShow = explicitCover || rawContentImage;
const bodyContent = coverToShow
    ? stripFirstImage(rawContent, explicitCover ? explicitCover : undefined)
    : rawContent;

const htmlContent = sanitizeArticleContent(markedInstance.parse(bodyContent) as string);

// 3. Fallback ke banner situs jika tidak ada gambar sama sekali atau gambar konten tidak aman
const resolvedImage = explicitCover || safeContentImage || `${siteBase}/banner.png`;

// URL absolut untuk Open Graph, Twitter Cards, dan Schema.org
const fullOgImage =
    resolvedImage.startsWith('http://') || resolvedImage.startsWith('https://')
        ? resolvedImage
        : `${siteBase}${resolvedImage.startsWith('/') ? '' : '/'}${resolvedImage}`;

const newsArticleSchema = {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": item.title,
    "description": item.summary,
    "datePublished": item.publishedAt,
    "dateModified": item.publishedAt,
    "author": {
        "@type": "Organization",
        "name": item.sourceName,
        "url": item.sourceUrl
    },
    "publisher": {
        "@type": "Person",
        "name": "Ahmad Fauzan Adiman",
        "url": siteBase
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
    },
    "image": fullOgImage
};
---

<BaseLayout
    variant="article"
    title={item.title}
    description={item.summary}
    breadcrumb={`cd ~/news/${item.id}`}
    backHref="/news"
    backLabel="cd ~/news"
    ogType="article"
    ogImage={fullOgImage}
    articlePublishedTime={item.publishedAt}
    articleAuthor={item.sourceName}
    articleTags={item.tags}
    schemaJsonLd={newsArticleSchema}
    noindex={Boolean(item.draft)}
>
    <div class="flex flex-col lg:flex-row lg:items-start gap-8 lg:gap-12 relative">
        {toc.length > 0 && (
            <aside class="hidden lg:block w-64 shrink-0">
                <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-4 font-mono text-xs border-r border-dashed border-muted/60">
                    <div class="text-primary font-bold mb-3 uppercase tracking-wider flex items-center gap-1.5">
                        <span class="text-accent">&gt;</span>
                        <span>ON THIS PAGE</span>
                    </div>
                    <ul class="space-y-1.5" id="toc-list">
                        {toc.map((item) => (
                            <li class={item.depth === 3 ? "pl-3 text-[11px]" : "font-medium"}>
                                <a
                                    href={`#${item.id}`}
                                    data-toc-id={item.id}
                                    class="toc-link block text-muted hover:text-primary transition-colors duration-150 no-underline py-0.5"
                                >
                                    {item.depth === 3 ? "└ " : "├ "}{item.text}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </aside>
        )}

        <div class="min-w-0 flex-1">
            <!-- Article header -->
            <header class="border-b border-muted pb-5">
                <h1 class="font-mono text-2xl sm:text-3xl md:text-4xl font-bold text-primary leading-tight tracking-tight mb-3">
                    {item.title}
                </h1>
                {item.summary && (
                    <p class="font-sans text-sm sm:text-base text-accent leading-relaxed mb-4">
                        {item.summary}
                    </p>
                )}
                <div class="border-t border-dashed border-muted pt-3 flex flex-wrap items-center justify-between gap-3 font-mono text-xs text-accent">
                    <div class="flex flex-wrap items-center gap-3">
                        <span>&gt; date: {formatDate(item.publishedAt)}</span>
                        <span class="text-muted">|</span>
                        <span>&gt; source: {item.sourceName}</span>
                        {rawContent && (
                            <>
                                <span class="text-muted">|</span>
                                <span>&gt; {readTime}m read</span>
                            </>
                        )}
                    </div>
                    {item.tags && item.tags.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                            {item.tags.map((tag: string) => (
                                <span class="border border-muted bg-surface font-mono text-xs text-text px-2.5 py-1">
                                    #{tag}
                                </span>
                            ))}
                        </div>
                    )}
                </div>
            </header>

            {item.draft && (
                <div class="border border-yellow-500/40 bg-yellow-500/10 text-yellow-300 p-3 font-mono text-xs flex flex-wrap items-center justify-between gap-2 my-4">
                    <span>[DRAFT PREVIEW] Konten berita ini berstatus draft dan hanya dapat dilihat oleh admin terautentikasi.</span>
                    <a href="/writer/dashboard/news" class="underline hover:text-white cursor-[crosshair]">[Kembali ke CMS]</a>
                </div>
            )}

            <!-- Optional Cover Image (Compact Editorial Banner) -->
            {coverToShow && (
                <div class="my-4 sm:my-5 border border-muted bg-surface overflow-hidden">
                    <img
                        src={coverToShow}
                        alt={item.title}
                        class="w-full max-h-[190px] sm:max-h-[260px] md:max-h-[320px] object-cover object-center"
                        loading="eager"
                    />
                </div>
            )}

            <!-- Mobile Table of Contents (< 1024px) -->
            {toc.length > 0 && (
                <details class="lg:hidden bg-surface border border-muted p-3 my-4 font-mono text-xs">
                    <summary class="font-bold text-primary cursor-pointer uppercase select-none flex items-center justify-between">
                        <span class="flex items-center gap-1.5">
                            <span class="text-accent">&gt;</span>
                            <span>ON THIS PAGE [{toc.length}]</span>
                        </span>
                        <span class="text-accent text-[10px]">[TOGGLE]</span>
                    </summary>
                    <ul class="mt-3 space-y-1.5 pl-2 border-l border-muted">
                        {toc.map((item) => (
                            <li class={item.depth === 3 ? "pl-3 text-[11px]" : "font-medium"}>
                                <a
                                    href={`#${item.id}`}
                                    data-toc-id={item.id}
                                    class="toc-link block text-muted hover:text-primary transition-colors duration-150 no-underline py-0.5"
                                >
                                    {item.depth === 3 ? "└ " : "├ "}{item.text}
                                </a>
                            </li>
                        ))}
                    </ul>
                </details>
            )}

            <!-- Article body -->
            {rawContent ? (
                <article class="article-content font-sans text-base text-text leading-relaxed mt-6" set:html={htmlContent}>
                </article>
            ) : (
                <div class="mt-6 border border-dashed border-muted p-8 text-center">
                    <p class="font-mono text-sm text-accent mb-4">{item.summary}</p>
                    <a
                        href={item.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-sm text-primary hover:underline cursor-[crosshair]"
                    >
                        [Read full article at {item.sourceName}]
                    </a>
                </div>
            )}

            <!-- Footer -->
            <footer class="border-t border-muted pt-6 font-mono text-sm text-accent flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mt-8">
                <div class="flex items-center gap-3">
                    <span>EOF</span>
                    <span class="text-muted">|</span>
                    <a
                        href={item.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-primary transition-colors duration-0 cursor-[crosshair]"
                    >
                        [Source: {item.sourceName}]
                    </a>
                </div>
                <div class="flex gap-4">
                    <a href="/news" class="hover:text-primary transition-colors duration-0 cursor-[crosshair]">[Back to News]</a>
                    <a href="#" class="hover:text-primary transition-colors duration-0 cursor-[crosshair]">[Top]</a>
                </div>
            </footer>
        </div>
    </div>
</BaseLayout>

<script>
    function setupScrollspy() {
        const headings = Array.from(
            document.querySelectorAll('.article-content h2[id], .article-content h3[id]')
        ) as HTMLElement[];
        const tocLinks = Array.from(
            document.querySelectorAll('.toc-link')
        ) as HTMLAnchorElement[];

        if (!headings.length || !tocLinks.length) return;

        const activeClasses = ['text-primary', 'font-bold', 'bg-surface/50', 'border-l', 'border-primary', 'pl-1.5'];
        const mutedClasses = ['text-muted'];

        function setActive(id: string) {
            if (!id) return;
            tocLinks.forEach((link) => {
                const linkId = link.getAttribute('data-toc-id');
                if (linkId === id) {
                    activeClasses.forEach((cls) => link.classList.add(cls));
                    mutedClasses.forEach((cls) => link.classList.remove(cls));
                    const asideNav = link.closest('nav');
                    if (asideNav && asideNav.scrollHeight > asideNav.clientHeight) {
                        const linkTop = (link as HTMLElement).offsetTop;
                        const navTop = asideNav.scrollTop;
                        const navHeight = asideNav.clientHeight;
                        if (linkTop < navTop || linkTop > navTop + navHeight - 32) {
                            asideNav.scrollTop = linkTop - navHeight / 2;
                        }
                    }
                } else {
                    activeClasses.forEach((cls) => link.classList.remove(cls));
                    mutedClasses.forEach((cls) => link.classList.add(cls));
                }
            });
        }

        // Set initial active heading
        const currentHash = window.location.hash ? window.location.hash.slice(1) : '';
        if (currentHash && headings.some((h) => h.id === currentHash)) {
            setActive(currentHash);
        } else if (headings[0] && headings[0].id) {
            setActive(headings[0].id);
        }

        // IntersectionObserver for scrollspy
        const observer = new IntersectionObserver(
            (entries) => {
                const visibleEntries = entries.filter((e) => e.isIntersecting);
                if (visibleEntries.length > 0) {
                    visibleEntries.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
                    setActive(visibleEntries[0].target.id);
                } else {
                    const aboveHeadings = headings.filter((h) => h.getBoundingClientRect().top <= 140);
                    if (aboveHeadings.length > 0) {
                        setActive(aboveHeadings[aboveHeadings.length - 1].id);
                    }
                }
            },
            {
                rootMargin: '-80px 0px -60% 0px',
                threshold: [0, 1],
            }
        );

        headings.forEach((h) => observer.observe(h));

        // Fallback scroll listener for continuous tracking
        let ticking = false;
        const onScroll = () => {
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    const scrollPos = window.scrollY + 140;
                    let currentId = headings[0]?.id || '';
                    for (let i = 0; i < headings.length; i++) {
                        if (headings[i].offsetTop <= scrollPos) {
                            currentId = headings[i].id;
                        } else {
                            break;
                        }
                    }
                    if (currentId) setActive(currentId);
                    ticking = false;
                });
                ticking = true;
            }
        };
        window.addEventListener('scroll', onScroll, { passive: true });

        // Smooth scroll on click & mobile accordion collapse
        const mobileDetails = document.querySelector('details.lg\\:hidden');
        tocLinks.forEach((link) => {
            link.addEventListener('click', (e) => {
                const id = link.getAttribute('data-toc-id');
                const target = id ? document.getElementById(id) : null;
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth' });
                    history.pushState(null, '', `#${id}`);
                    setActive(id);

                    if (mobileDetails && mobileDetails.hasAttribute('open')) {
                        mobileDetails.removeAttribute('open');
                    }
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScrollspy);
    } else {
        setupScrollspy();
    }
    document.addEventListener('astro:page-load', setupScrollspy);
</script>

<style is:global>
    /* Global Article Content Styling — same as blog */
    .article-content {
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .article-content p {
        margin-bottom: 1.5rem;
        line-height: 1.8;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .article-content h2 {
        font-family: "JetBrains Mono", monospace;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--color-primary);
        margin-top: 2.25rem;
        margin-bottom: 1rem;
        border-left: 3px solid var(--color-primary);
        padding-left: 0.85rem;
        scroll-margin-top: 6rem;
    }
    .article-content h3 {
        font-family: "JetBrains Mono", monospace;
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--color-text);
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
        scroll-margin-top: 6rem;
    }
    .article-content h4, .article-content h5, .article-content h6 {
        font-family: "JetBrains Mono", monospace;
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-muted);
        margin-top: 1.25rem;
        margin-bottom: 0.5rem;
    }
    .article-content ul, .article-content ol {
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .article-content ul { list-style-type: disc; }
    .article-content ol { list-style-type: decimal; }
    .article-content li {
        margin-bottom: 0.5rem;
        line-height: 1.75;
    }
    .article-content a {
        color: var(--color-primary);
        border-bottom: 1px dashed var(--color-accent);
        text-decoration: none;
        transition: border-color 0.2s ease;
    }
    .article-content a:hover {
        border-color: var(--color-primary);
    }
    .article-content inline-code, .article-content code:not(pre code) {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.875em;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        padding: 0.15rem 0.4rem;
        color: var(--color-text);
    }
    .article-content pre {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        padding: 1.25rem;
        overflow-x: auto;
        margin-bottom: 1.5rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.875rem;
        line-height: 1.6;
    }
    .article-content pre code {
        border: none;
        padding: 0;
        background: transparent;
        font-size: inherit;
        color: var(--color-text);
    }
    .article-content blockquote {
        border-left: 3px solid var(--color-border);
        background-color: var(--color-surface);
        padding: 1rem 1.25rem;
        color: var(--color-text);
        margin: 1.5rem 0;
        font-style: italic;
    }
    .article-content img {
        max-width: 100%;
        height: auto;
        border: 1px solid var(--color-border);
        margin: 1.75rem 0;
        display: block;
        background-color: var(--color-surface);
    }
    .article-content .table-container {
        width: 100%;
        overflow-x: auto;
        margin: 1.5rem 0;
        border: 1px solid var(--color-border);
    }
    .article-content .markdown-table {
        width: 100%;
        border-collapse: collapse;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.875rem;
        text-align: left;
    }
    .article-content .markdown-table th {
        background-color: var(--color-surface);
        color: var(--color-primary);
        font-weight: 700;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--color-border);
        text-transform: uppercase;
    }
    .article-content .markdown-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px dashed var(--color-border);
        color: var(--color-text);
    }
    .article-content .markdown-table tr:hover td {
        background-color: var(--color-surface);
    }
    .article-content .terminal-hr {
        border: none;
        border-top: 1px dashed var(--color-border);
        margin: 2rem 0;
    }
</style>
