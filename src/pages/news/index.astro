---
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');

import BaseLayout from "@layouts/BaseLayout.astro";
import { listPublishedNewsPaginated, getNewsFilterMetadata } from "../../lib/news";
import { getProfileData } from "../../lib/cms";
import { formatDate } from "../../lib/utils";

const profileData = await getProfileData();
const metadata = await getNewsFilterMetadata();

const PAGE_SIZE = 15;
const rawPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const requestedPage = isNaN(rawPage) || rawPage < 1 ? 1 : rawPage;
const selectedDate = Astro.url.searchParams.get('date') || 'all';
const selectedTag = Astro.url.searchParams.get('tag') || 'all';

const { items: news, total: totalFilteredItems, page, totalPages } = await listPublishedNewsPaginated({
    page: requestedPage,
    pageSize: PAGE_SIZE,
    tag: selectedTag,
    date: selectedDate,
});

const username = profileData.terminalPrompt ? profileData.terminalPrompt.split('@')[0] : "user";
const isFiltered = selectedDate !== 'all' || selectedTag !== 'all' || page > 1;

function buildNewsUrl(targetPage: number, tag = selectedTag, date = selectedDate): string {
    const params = new URLSearchParams();
    if (date && date !== 'all') params.set('date', date);
    if (tag && tag !== 'all') params.set('tag', tag);
    if (targetPage > 1) params.set('page', String(targetPage));
    const qs = params.toString();
    return `/news${qs ? `?${qs}` : ''}`;
}

const siteBase = process.env.PUBLIC_SITE_URL && !process.env.PUBLIC_SITE_URL.includes('localhost')
    ? process.env.PUBLIC_SITE_URL.replace(/\/$/, '')
    : 'https://www.efzyn.my.id';

const cleanCanonical = `${siteBase}/news`;
const prevPageUrl = page > 1 ? buildNewsUrl(page - 1) : undefined;
const nextPageUrl = page < totalPages ? buildNewsUrl(page + 1) : undefined;
const prevFullUrl = prevPageUrl ? `${siteBase}${prevPageUrl}` : undefined;
const nextFullUrl = nextPageUrl ? `${siteBase}${nextPageUrl}` : undefined;

function getPaginationItems(current: number, total: number): (number | string)[] {
    if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
    }
    if (current <= 4) {
        return [1, 2, 3, 4, 5, '...', total];
    }
    if (current >= total - 3) {
        return [1, '...', total - 4, total - 3, total - 2, total - 1, total];
    }
    return [1, '...', current - 1, current, current + 1, '...', total];
}

const paginationItems = getPaginationItems(page, totalPages);
---

<BaseLayout
    title="News"
    description={`Tech news yang dikurasi oleh ${profileData.name}`}
    breadcrumb="cd ~/news"
    backHref="/"
    backLabel="cd ~/"
    canonicalUrl={cleanCanonical}
    prevUrl={prevFullUrl}
    nextUrl={nextFullUrl}
>
    <!-- Header -->
    <header class="mb-6">
        <p class="font-mono text-xs text-muted mb-1">&gt; cd ~/news</p>
        <h1 class="font-mono text-2xl sm:text-3xl font-bold text-primary mb-1">
            Berita Teknologi Terkini & Analisis Industri <span class="text-accent font-normal text-base sm:text-lg">({metadata.total})</span>
        </h1>
        <p class="font-mono text-xs text-muted">
            drwxr-xr-x {username} users 4096 . ~/news
        </p>
    </header>

    <!-- Modular Dropdown Filter Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs py-2.5 px-3 bg-surface border border-muted">
        <div class="flex flex-wrap items-center gap-3">
            <span class="text-primary font-bold flex items-center gap-1.5 select-none">
                <span class="inline-block w-2 h-2 bg-primary"></span>
                FILTER:
            </span>

            <!-- Date Selector Dropdown -->
            <div class="flex items-center gap-1.5">
                <label for="filter-date" class="text-accent select-none">&gt; date:</label>
                <select
                    id="filter-date"
                    class="bg-background border border-muted hover:border-accent focus:border-primary focus:outline-none text-text text-xs px-2 py-1 font-mono cursor-[crosshair] transition-colors"
                >
                    <option value="all" selected={selectedDate === 'all'}>Semua Tanggal ({metadata.total})</option>
                    {metadata.dates.map((item) => (
                        <option value={item.date} selected={selectedDate === item.date}>
                            {item.date} ({item.count})
                        </option>
                    ))}
                </select>
            </div>

            <!-- Tag Selector Dropdown -->
            <div class="flex items-center gap-1.5">
                <label for="filter-tag" class="text-accent select-none">&gt; tag:</label>
                <select
                    id="filter-tag"
                    class="bg-background border border-muted hover:border-accent focus:border-primary focus:outline-none text-text text-xs px-2 py-1 font-mono cursor-[crosshair] transition-colors"
                >
                    <option value="all" selected={selectedTag === 'all'}>Semua Tag ({metadata.tags.length})</option>
                    {metadata.tags.map((item) => (
                        <option value={item.tag} selected={selectedTag === item.tag}>
                            #{item.tag} ({item.count})
                        </option>
                    ))}
                </select>
            </div>

            <!-- Reset Button -->
            {isFiltered ? (
                <a
                    href="/news"
                    id="btn-reset-filters"
                    class="border border-muted hover:border-primary bg-background text-accent hover:text-primary px-2.5 py-1 text-xs font-mono cursor-[crosshair] transition-colors no-underline"
                    title="Reset semua filter"
                >
                    [ RESET ]
                </a>
            ) : (
                <button
                    type="button"
                    id="btn-reset-filters"
                    class="hidden border border-muted hover:border-primary bg-background text-accent hover:text-primary px-2.5 py-1 text-xs font-mono cursor-[crosshair] transition-colors"
                    title="Reset semua filter"
                >
                    [ RESET ]
                </button>
            )}
        </div>

        <!-- Filter Count Badge -->
        <div class="text-muted font-mono text-[11px] self-center">
            <span id="filter-result-count" class="text-primary font-bold">{totalFilteredItems}</span> / {metadata.total} items
        </div>
    </div>

    <!-- Table header (desktop only) -->
    <div
        class="hidden md:grid grid-cols-[120px_120px_1fr] gap-4 px-4 py-2 font-mono text-xs font-bold border-b border-muted text-primary uppercase"
    >
        <div>Date</div>
        <div>Source</div>
        <div>Title & Summary</div>
    </div>

    <!-- News list -->
    <div id="news-container" class="flex flex-col">
        {
            news.length === 0 ? (
                <div id="no-results" class="py-12 flex flex-col items-center justify-center gap-3 border border-dashed border-muted my-4">
                    <p class="font-mono text-xs text-accent">Tidak ada berita yang cocok dengan kriteria filter.</p>
                    <a
                        href="/news"
                        class="border border-muted hover:border-primary bg-surface text-primary px-3 py-1.5 text-xs font-mono cursor-[crosshair] transition-colors no-underline"
                    >
                        [ LIHAT SEMUA BERITA ]
                    </a>
                </div>
            ) : (
                news.map((item) => {
                    const dateFormatted = formatDate(item.publishedAt);
                    const coverThumbnail = item.coverImage || item.cover_image;

                    return (
                        <a
                            id={`news-${item.id}`}
                            href={`/news/${item.id}`}
                            class="news-row terminal-hover group grid grid-cols-1 md:grid-cols-[120px_120px_1fr] gap-2 md:gap-4 px-4 py-4 md:py-3 border-b border-dashed border-muted transition-colors duration-0 no-underline cursor-[crosshair]"
                        >
                            <div class="font-mono text-xs text-accent self-start md:self-center">
                                {dateFormatted}
                            </div>
                            <div class="font-mono text-xs text-muted self-start md:self-center font-bold tracking-wider">
                                [{item.sourceName}]
                            </div>
                            <div class="flex items-center gap-3.5 self-center min-w-0">
                                {coverThumbnail && (
                                    <div class="w-16 h-12 md:w-20 md:h-14 shrink-0 border border-muted overflow-hidden bg-background">
                                        <img
                                            src={coverThumbnail}
                                            alt={item.title}
                                            class="w-full h-full object-cover grayscale contrast-125 brightness-90 group-hover:grayscale-0 transition-all duration-200"
                                            loading="lazy"
                                        />
                                    </div>
                                )}
                                <div class="flex flex-col gap-1 min-w-0">
                                    <div class="font-sans text-base font-medium text-text title-text group-hover:text-primary transition-colors duration-0 line-clamp-2 md:line-clamp-1">
                                        {item.title}
                                    </div>
                                    {item.summary && (
                                        <p class="font-sans text-xs text-accent line-clamp-1">
                                            {item.summary}
                                        </p>
                                    )}
                                </div>
                            </div>
                        </a>
                    );
                })
            )
        }
    </div>

    <!-- Terminal Pagination Bar -->
    {totalPages > 1 && (
        <nav aria-label="News Pagination" class="flex flex-wrap items-center justify-between gap-3 pt-6 pb-4 border-t border-muted font-mono text-xs mt-4">
            <div class="text-muted text-[11px] self-center">
                PAGE <span class="text-primary font-bold">{page}</span> OF <span class="text-primary font-bold">{totalPages}</span> ({totalFilteredItems} items)
            </div>
            <div class="flex items-center gap-1.5 flex-wrap">
                {page > 1 ? (
                    <a
                        href={prevPageUrl}
                        class="border border-muted hover:border-primary bg-background text-accent hover:text-primary px-2.5 py-1 text-xs transition-colors cursor-[crosshair] no-underline"
                    >
                        [ &lt; PREV ]
                    </a>
                ) : (
                    <span class="border border-muted/30 text-muted/30 px-2.5 py-1 text-xs select-none cursor-not-allowed">
                        [ &lt; PREV ]
                    </span>
                )}

                {paginationItems.map((p) => {
                    if (p === '...') {
                        return <span class="px-1 text-muted select-none">...</span>;
                    }
                    const isCurrent = p === page;
                    return isCurrent ? (
                        <span class="border border-primary bg-surface text-primary font-bold px-2.5 py-1 text-xs select-none">
                            [ {p} ]
                        </span>
                    ) : (
                        <a
                            href={buildNewsUrl(Number(p))}
                            class="border border-muted hover:border-primary bg-background text-accent hover:text-primary px-2.5 py-1 text-xs transition-colors cursor-[crosshair] no-underline"
                        >
                            [ {p} ]
                        </a>
                    );
                })}

                {page < totalPages ? (
                    <a
                        href={nextPageUrl}
                        class="border border-muted hover:border-primary bg-background text-accent hover:text-primary px-2.5 py-1 text-xs transition-colors cursor-[crosshair] no-underline"
                    >
                        [ NEXT &gt; ]
                    </a>
                ) : (
                    <span class="border border-muted/30 text-muted/30 px-2.5 py-1 text-xs select-none cursor-not-allowed">
                        [ NEXT &gt; ]
                    </span>
                )}
            </div>
        </nav>
    )}

    <!-- Client-Side Filter Navigation Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const dateSelect = document.getElementById('filter-date');
            const tagSelect = document.getElementById('filter-tag');

            function applyFilterNavigation() {
                const selectedDate = dateSelect ? dateSelect.value : 'all';
                const selectedTag = tagSelect ? tagSelect.value : 'all';

                const params = new URLSearchParams();
                if (selectedDate !== 'all') params.set('date', selectedDate);
                if (selectedTag !== 'all') params.set('tag', selectedTag);
                const qs = params.toString();
                window.location.href = '/news' + (qs ? '?' + qs : '');
            }

            if (dateSelect) {
                dateSelect.addEventListener('change', applyFilterNavigation);
            }

            if (tagSelect) {
                tagSelect.addEventListener('change', applyFilterNavigation);
            }
        });
    </script>
</BaseLayout>
