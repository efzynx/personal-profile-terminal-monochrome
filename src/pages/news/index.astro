---
export const prerender = false;
import BaseLayout from "@layouts/BaseLayout.astro";
import { listNews } from "../../lib/news";
import { getProfileData } from "../../lib/cms";
import { formatDate } from "../../lib/utils";

const profileData = await getProfileData();
const news = await listNews();

const username = profileData.terminalPrompt ? profileData.terminalPrompt.split('@')[0] : "user";

const allTags = Array.from(new Set(news.flatMap(n => n.tags || [])));
---

<BaseLayout
    title="News"
    description={`Tech news yang dikurasi oleh ${profileData.name}`}
    breadcrumb="cd ~/news"
    backHref="/"
    backLabel="cd ~/"
>
    <!-- Header -->
    <header class="pb-3">
        <h1 class="font-mono text-lg md:text-xl font-bold text-primary">
            ~/news <span class="text-accent font-normal text-sm">({news.length})</span>
        </h1>
        <p class="font-mono text-xs text-muted mt-1">
            drwxr-xr-x {username} users 4096 . ~/news
        </p>
    </header>

    <!-- Tag Filter -->
    {allTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs py-2 border-b border-muted">
            <span class="text-accent font-bold">[FILTER]:</span>
            <button
                type="button"
                class="filter-btn active-filter border border-primary bg-primary text-background px-2.5 py-1 cursor-[crosshair]"
                data-tag="all"
            >
                [ ALL ]
            </button>
            {allTags.map((tag) => (
                <button
                    type="button"
                    class="filter-btn border border-muted bg-surface text-accent hover:text-primary hover:border-primary px-2.5 py-1 cursor-[crosshair] transition-colors"
                    data-tag={tag.toLowerCase()}
                >
                    [{tag}]
                </button>
            ))}
        </div>
    )}

    <!-- News List -->
    <div id="news-container" class="flex flex-col">
        {
            news.length === 0 ? (
                <div class="py-12 flex justify-center border border-dashed border-muted">
                    <p class="font-mono text-xs text-accent">Belum ada berita.</p>
                </div>
            ) : (
                news.map((item) => {
                    const tagsLower = (item.tags || []).map(t => t.toLowerCase()).join(' ');
                    return (
                        <div
                            class="news-row border-b border-dashed border-muted px-4 py-4 md:py-3 transition-colors duration-0"
                            data-tags={tagsLower}
                        >
                            <div class="flex flex-col gap-2">
                                <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
                                    <span class="text-accent">{formatDate(item.publishedAt)}</span>
                                    <span class="text-muted">|</span>
                                    <span class="text-muted">{item.sourceName}</span>
                                </div>

                                <div class="flex flex-col md:flex-row md:items-start gap-3">
                                    {item.coverImage && (
                                        <img
                                            src={item.coverImage}
                                            alt={item.title}
                                            class="w-full md:w-32 h-20 object-cover border border-muted shrink-0 grayscale contrast-125 brightness-90"
                                            loading="lazy"
                                        />
                                    )}
                                    <div class="flex flex-col gap-1">
                                        <h2 class="font-mono text-base font-bold text-text">
                                            {item.title}
                                        </h2>
                                        <p class="font-sans text-xs text-accent leading-relaxed">
                                            {item.summary}
                                        </p>
                                        <div class="flex flex-wrap items-center gap-2 mt-1">
                                            {(item.tags || []).map((tag) => (
                                                <span class="font-mono text-[10px] text-muted border border-muted px-1.5 py-0.5">
                                                    #{tag}
                                                </span>
                                            ))}
                                            <a
                                                href={item.sourceUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="font-mono text-[10px] text-primary hover:underline cursor-[crosshair] ml-auto"
                                            >
                                                [source]
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                })
            )
        }
    </div>

    <div id="no-results" class="hidden py-12 flex justify-center border border-dashed border-muted">
        <p class="font-mono text-xs text-accent">Tidak ada berita dengan tag tersebut.</p>
    </div>

    <!-- Client-Side Filter Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const newsRows = document.querySelectorAll('.news-row');
            const filterBtns = document.querySelectorAll('.filter-btn');
            const noResults = document.getElementById('no-results');

            let activeTag = 'all';

            function filterNews() {
                let visibleCount = 0;
                newsRows.forEach((row) => {
                    const rowTags = row.getAttribute('data-tags') || '';
                    const matches = activeTag === 'all' || rowTags.includes(activeTag);
                    if (matches) {
                        row.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        row.classList.add('hidden');
                    }
                });
                if (noResults) {
                    noResults.classList.toggle('hidden', visibleCount > 0);
                }
            }

            filterBtns.forEach((btn) => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach((b) => {
                        b.classList.remove('active-filter', 'bg-primary', 'text-background');
                        b.classList.add('bg-surface', 'text-accent');
                    });
                    btn.classList.add('active-filter', 'bg-primary', 'text-background');
                    btn.classList.remove('bg-surface', 'text-accent');
                    activeTag = btn.getAttribute('data-tag') || 'all';
                    filterNews();
                });
            });
        });
    </script>
</BaseLayout>
