---
import '../../../../styles/global.css';
import { getSession } from '../../../../lib/auth';
import { getNewsItem, getProfileData as _getProfileData } from '../../../../lib/news';
import { getProfileData } from '../../../../lib/cms';
import TerminalModal from '../../../../components/TerminalModal.astro';
import ThemeToggle from '../../../../components/ThemeToggle.astro';

const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/writer');
}

const profile = await getProfileData(session.token);
const activeFavicon = profile.faviconUrl || '/favicon.svg';
const isSvgFavicon = activeFavicon.endsWith('.svg');
const promptPrefix = profile.terminalPrompt || `${session.user}@tux`;

// Determine mode: edit or add
const targetId = Astro.url.searchParams.get('id');
let existingItem = null;

if (targetId) {
  try {
    existingItem = await getNewsItem(targetId);
  } catch (e) {
    console.error('Error fetching news item for edit:', e);
  }
}

const isEditMode = Boolean(existingItem);

// Generate a new news ID for add mode (server-side)
function generateNewsId(): string {
  const now = new Date();
  const ts = now.toISOString().slice(0, 10).replace(/-/g, '');
  const rand = Math.random().toString(36).substring(2, 8).padEnd(6, '0');
  return `news-${ts}-${rand}`;
}

const defaultId = existingItem ? existingItem.id : generateNewsId();
const defaultTitle = existingItem ? existingItem.title : '';
const defaultSourceName = existingItem ? existingItem.sourceName : '';
const defaultSourceUrl = existingItem ? existingItem.sourceUrl : '';
const defaultSummary = existingItem ? existingItem.summary : '';
const defaultTags = existingItem && existingItem.tags ? existingItem.tags.join(', ') : '';
const defaultCover = existingItem ? (existingItem.coverImage || '') : '';
const defaultDraft = existingItem ? existingItem.draft : true;
const defaultContent = existingItem ? existingItem.content : '';
const defaultPublishedAt = existingItem ? existingItem.publishedAt : new Date().toISOString();
---

<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isEditMode ? `Edit News: ${defaultTitle}` : 'Add News Item'} — Writer</title>
    {isSvgFavicon ? (
        <link rel="icon" type="image/svg+xml" href={activeFavicon} />
    ) : (
        <link rel="icon" href={activeFavicon} />
    )}

    <script is:inline>
        (function () {
            var storedTheme = localStorage.getItem('theme') || 'system';
            var isDark =
                storedTheme === 'dark' ||
                (storedTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap"
        rel="stylesheet"
    />

    <!-- Marked Library for Client-Side Live Rendering -->
    <script is:inline src="/vendor/marked.min.js"></script>

    <style is:global>
        :root {
            --color-background: #ffffff;
            --color-surface: #f4f4f5;
            --color-border: #e5e5e5;
            --color-text: #18181b;
            --color-muted: #71717a;
            --color-accent: #52525b;
            --color-primary: #000000;
        }

        html.dark {
            --color-background: #0a0a0a;
            --color-surface: #141414;
            --color-border: #2a2a2a;
            --color-text: #d4d4d4;
            --color-muted: #5a5a5a;
            --color-accent: #8a8a8a;
            --color-primary: #f0f0f0;
        }

        body {
            background-color: var(--color-background);
            color: var(--color-text);
            font-family: "JetBrains Mono", monospace;
        }

        /* Article Content Live Preview Typography & Elements */
        .article-content {
            overflow-wrap: anywhere;
            word-break: break-word;
        }
        .article-content p {
            margin-bottom: 1.5rem;
            line-height: 1.8;
            overflow-wrap: anywhere;
            word-break: break-word;
        }
        .article-content h1 {
            font-family: "JetBrains Mono", monospace;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--color-primary);
            margin-top: 2rem;
            margin-bottom: 1rem;
            border-left: 4px solid var(--color-primary);
            padding-left: 0.75rem;
        }
        .article-content h2 {
            font-family: "JetBrains Mono", monospace;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--color-primary);
            margin-top: 2rem;
            margin-bottom: 0.85rem;
            border-left: 3px solid var(--color-primary);
            padding-left: 0.75rem;
            scroll-margin-top: 2rem;
        }
        .article-content h3 {
            font-family: "JetBrains Mono", monospace;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--color-text);
            margin-top: 1.5rem;
            margin-bottom: 0.75rem;
            scroll-margin-top: 2rem;
        }
        .article-content h4, .article-content h5, .article-content h6 {
            font-family: "JetBrains Mono", monospace;
            font-size: 1rem;
            font-weight: 600;
            color: var(--color-muted);
            margin-top: 1.25rem;
            margin-bottom: 0.5rem;
        }
        .article-content ul, .article-content ol {
            padding-left: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .article-content ul { list-style-type: disc; }
        .article-content ol { list-style-type: decimal; }
        .article-content li {
            margin-bottom: 0.5rem;
            line-height: 1.75;
        }
        .article-content a {
            color: var(--color-primary);
            border-bottom: 1px dashed var(--color-accent);
            text-decoration: none;
            transition: border-color 0.2s ease;
        }
        .article-content a:hover {
            border-color: var(--color-primary);
        }
        .article-content code:not(pre code) {
            font-family: "JetBrains Mono", monospace;
            font-size: 0.875em;
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            padding: 0.15rem 0.4rem;
            color: var(--color-text);
        }
        .article-content pre {
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            padding: 1.25rem;
            overflow-x: auto;
            margin-bottom: 1.5rem;
            font-family: "JetBrains Mono", monospace;
            font-size: 0.875rem;
            line-height: 1.6;
        }
        .article-content pre code {
            border: none;
            padding: 0;
            background: transparent;
            font-size: inherit;
            color: var(--color-text);
        }
        .article-content blockquote {
            border-left: 3px solid var(--color-border);
            background-color: var(--color-surface);
            padding: 1rem 1.25rem;
            color: var(--color-text);
            margin: 1.5rem 0;
            font-style: italic;
        }
        .article-content img {
            max-width: 100%;
            height: auto;
            border: 1px solid var(--color-border);
            margin: 1.75rem 0;
            display: block;
            background-color: var(--color-surface);
        }
        .article-content .table-container {
            width: 100%;
            overflow-x: auto;
            margin: 1.5rem 0;
            border: 1px solid var(--color-border);
        }
        .article-content .markdown-table {
            width: 100%;
            border-collapse: collapse;
            font-family: "JetBrains Mono", monospace;
            font-size: 0.875rem;
            text-align: left;
        }
        .article-content .markdown-table th {
            background-color: var(--color-surface);
            color: var(--color-primary);
            font-weight: 700;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--color-border);
            text-transform: uppercase;
        }
        .article-content .markdown-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px dashed var(--color-border);
            color: var(--color-text);
        }
        .article-content .markdown-table tr:hover td {
            background-color: var(--color-surface);
        }
        .article-content .terminal-hr {
            border: none;
            border-top: 1px dashed var(--color-border);
            margin: 2rem 0;
        }
        .article-content kbd {
            font-family: "JetBrains Mono", monospace;
            font-size: 0.75rem;
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            box-shadow: 0 2px 0 var(--color-border);
            padding: 0.15rem 0.4rem;
            color: var(--color-primary);
        }
    </style>
</head>
<body class="min-h-screen bg-background text-text flex justify-center pt-8 sm:pt-12 md:pt-16 lg:pt-20 pb-16 md:pb-24 px-5 sm:px-8 md:px-12 lg:px-16">
    <div class="w-full max-w-7xl flex flex-col gap-6">

        <!-- Top Nav Bar -->
        <nav class="flex flex-wrap items-center justify-between gap-4 font-mono text-sm border-b border-muted pb-4">
            <div class="flex items-center gap-2 text-accent">
                <span class="material-symbols-outlined text-[16px] text-primary">edit_note</span>
                <a href="/writer/dashboard/news" class="hover:text-primary no-underline text-accent">news</a>
                <span>/</span>
                <span class="text-primary font-bold">{isEditMode ? `edit [${defaultId}]` : 'new-item'}</span>
            </div>

            <div class="flex items-center gap-4 text-xs">
                <ThemeToggle />

                <div class="flex items-center gap-2 text-accent border border-muted px-3 py-1">
                    {session.avatarUrl && <img src={session.avatarUrl} alt="User" class="w-4 h-4 rounded-full" />}
                    <span>user: <strong class="text-primary">{session.user}</strong></span>
                </div>

                <a
                    href="/writer/dashboard/news"
                    class="font-mono text-xs text-accent hover:text-text border border-muted px-3 py-1.5 no-underline cursor-[crosshair]"
                >
                    &lt;-- [ CANCEL / BACK ]
                </a>
            </div>
        </nav>

        <!-- Header Block -->
        <header class="border-b border-muted pb-4">
            <h1 class="font-mono text-2xl md:text-3xl font-bold text-primary tracking-tight uppercase">
                {isEditMode ? 'Edit News Item' : 'Add News Item'}
            </h1>
            <p class="font-mono text-xs text-muted mt-1">
                {isEditMode ? `Mengedit: ${defaultId}` : `ID baru: ${defaultId}`}
            </p>
        </header>

        <!-- Alert Box -->
        <div id="alert-box" class="hidden border p-4 font-mono text-xs"></div>

        <!-- Action Bar -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-surface border border-muted p-4">
            <div class="flex items-center gap-2 font-mono text-xs text-accent">
                <span class="w-2 h-2 rounded-full bg-green-500 inline-block animate-pulse"></span>
                <span>Status: <strong class="text-primary">{isEditMode ? 'EDITING EXISTING NEWS' : 'DRAFTING NEW NEWS'}</strong></span>
            </div>
            <div class="flex items-center gap-3">
                <button
                    type="button"
                    id="btn-save"
                    class="font-mono text-sm font-bold text-background bg-primary hover:bg-surface hover:text-primary border border-primary px-6 py-2 transition-colors duration-0 cursor-[crosshair] flex items-center gap-2"
                >
                    <span class="material-symbols-outlined text-base">save</span>
                    <span>[ SAVE NEWS ]</span>
                </button>
            </div>
        </div>

        <!-- Form Fields -->
        <div class="flex flex-col gap-4">
            <!-- Hidden fields -->
            <input type="hidden" id="news-id" value={defaultId} />
            <input type="hidden" id="news-published-at" value={defaultPublishedAt} />

            <!-- Metadata Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-surface border border-muted p-6">

                <!-- Title -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label for="news-title" class="font-mono text-xs text-accent font-bold">TITLE *</label>
                    <input
                        type="text"
                        id="news-title"
                        value={defaultTitle}
                        placeholder="Judul berita"
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- ID (read-only) -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label class="font-mono text-xs text-accent font-bold">ID (AUTO-GENERATED, READ-ONLY)</label>
                    <input
                        type="text"
                        value={defaultId}
                        readonly
                        class="bg-background border border-muted font-mono text-xs text-muted px-3 py-2 cursor-not-allowed opacity-70"
                    />
                </div>

                <!-- Source Name -->
                <div class="flex flex-col gap-1.5">
                    <label for="news-source-name" class="font-mono text-xs text-accent font-bold">SOURCE NAME *</label>
                    <input
                        type="text"
                        id="news-source-name"
                        value={defaultSourceName}
                        placeholder="Reuters, TechCrunch, dll."
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Source URL -->
                <div class="flex flex-col gap-1.5">
                    <label for="news-source-url" class="font-mono text-xs text-accent font-bold">SOURCE URL *</label>
                    <input
                        type="url"
                        id="news-source-url"
                        value={defaultSourceUrl}
                        placeholder="https://..."
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Summary with char counter -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <div class="flex items-center justify-between">
                        <label for="news-summary" class="font-mono text-xs text-accent font-bold">
                            SUMMARY * <span class="text-muted font-normal">(maks. 200 karakter)</span>
                        </label>
                        <span id="summary-counter" class="font-mono text-[10px] text-muted">{defaultSummary.length}/200</span>
                    </div>
                    <textarea
                        id="news-summary"
                        rows="3"
                        maxlength="200"
                        placeholder="Ringkasan 1-2 kalimat"
                        class="w-full bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    >{defaultSummary}</textarea>
                </div>

                <!-- Tags -->
                <div class="flex flex-col gap-1.5">
                    <label for="news-tags" class="font-mono text-xs text-accent font-bold">TAGS (COMMA SEPARATED)</label>
                    <input
                        type="text"
                        id="news-tags"
                        value={defaultTags}
                        placeholder="AI, cloud, devops"
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Cover Image -->
                <div class="flex flex-col gap-1.5">
                    <label for="news-cover" class="font-mono text-xs text-accent font-bold">COVER IMAGE URL (OPTIONAL)</label>
                    <input
                        type="url"
                        id="news-cover"
                        value={defaultCover}
                        placeholder="https://..."
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Draft Checkbox -->
                <div class="flex items-center gap-3 md:col-span-2 pt-2 border-t border-muted">
                    <label class="flex items-center gap-2 font-mono text-xs text-accent cursor-[crosshair] select-none">
                        <input
                            type="checkbox"
                            id="news-draft"
                            checked={defaultDraft}
                            class="bg-background border-muted text-primary focus:ring-0 cursor-[crosshair]"
                        />
                        Simpan sebagai draft (belum publish)
                    </label>
                </div>
            </div>

            <!-- Content Area: Editor + Live Preview -->
            <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between font-mono text-xs text-accent">
                    <span class="font-bold">CONTENT — MARKDOWN *</span>
                    <span class="text-muted">Supports Markdown formatting</span>
                </div>

                <!-- Live Preview & Split-Pane Toolbar -->
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-accent bg-surface border border-muted p-2.5">
                    <div class="flex items-center gap-3">
                        <span class="font-bold text-primary flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px]">view_column</span>
                            <span>LAYOUT:</span>
                        </span>

                        <!-- Desktop Presets -->
                        <div class="hidden lg:flex items-center gap-1.5" id="preset-container">
                            <button
                                type="button"
                                class="btn-preset font-mono text-xs px-2.5 py-1 border border-primary bg-surface text-primary font-bold transition-colors cursor-[crosshair]"
                                data-ratio="50"
                                title="Bagi rata 50% editor, 50% preview"
                            >
                                [ 50:50 ]
                            </button>
                            <button
                                type="button"
                                class="btn-preset font-mono text-xs px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                                data-ratio="80"
                                title="Fokus editor: 80% editor, 20% preview"
                            >
                                [ Focus Edit ]
                            </button>
                            <button
                                type="button"
                                class="btn-preset font-mono text-xs px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                                data-ratio="20"
                                title="Fokus preview: 20% editor, 80% preview"
                            >
                                [ Focus Preview ]
                            </button>
                        </div>

                        <!-- Mobile Toggle Button -->
                        <button
                            type="button"
                            id="btn-mobile-toggle"
                            class="lg:hidden flex items-center gap-1.5 font-mono text-xs px-3 py-1 border border-primary bg-primary text-background hover:bg-surface hover:text-primary transition-colors cursor-[crosshair] font-bold"
                            title="Beralih ke mode pratinjau"
                        >
                            <span id="mobile-toggle-icon">👁️</span>
                            <span id="mobile-toggle-text">PREVIEW</span>
                        </button>
                    </div>

                    <div class="flex items-center gap-4 text-xs font-mono text-muted">
                        <span id="char-word-counter">0 chars | 0 words</span>
                        <span class="hidden md:inline text-[10px] text-muted">&gt; debounced 150ms</span>
                    </div>
                </div>

                <!-- Split-Pane Container -->
                <div id="split-container" class="w-full flex flex-col lg:flex-row border border-muted bg-surface min-h-[550px] lg:h-[700px] relative">
                    <!-- Left: Editor Pane -->
                    <div id="pane-editor" class="w-full lg:w-1/2 flex flex-col min-w-0 bg-surface">
                        <div class="flex items-center justify-between font-mono text-[11px] text-accent px-3 py-1.5 border-b border-muted bg-background/30">
                            <span class="flex items-center gap-1.5 font-bold text-primary">
                                <span class="material-symbols-outlined text-[14px]">edit</span>
                                <span>MARKDOWN SOURCE</span>
                            </span>
                            <span class="text-muted text-[10px]">SCROLL SYNC ON</span>
                        </div>
                        <textarea
                            id="content"
                            placeholder="Konten lengkap berita dalam format Markdown..."
                            class="w-full flex-1 min-h-[450px] lg:min-h-0 bg-transparent border-0 focus:outline-none focus:ring-0 font-mono text-sm text-text p-4 resize-none leading-relaxed overflow-y-auto"
                        >{defaultContent}</textarea>
                    </div>

                    <!-- Draggable Divider (Desktop Only) -->
                    <div
                        id="split-divider"
                        class="hidden lg:flex items-center justify-center w-2.5 bg-background hover:bg-surface cursor-col-resize select-none shrink-0 border-x border-muted transition-colors relative group"
                        title="Tarik untuk mengatur rasio editor dan preview"
                    >
                        <div class="w-0.5 h-8 bg-muted group-hover:bg-primary transition-colors"></div>
                    </div>

                    <!-- Right: Preview Pane -->
                    <div id="pane-preview" class="hidden lg:flex w-full lg:w-1/2 flex-col min-w-0 bg-background">
                        <div class="flex items-center justify-between font-mono text-[11px] text-accent px-4 py-1.5 border-b border-muted bg-surface/50">
                            <span class="flex items-center gap-1.5 font-bold text-primary">
                                <span class="material-symbols-outlined text-[14px]">visibility</span>
                                <span>LIVE NEWS PREVIEW</span>
                            </span>
                            <span id="preview-meta" class="text-muted text-[10px]">0 words</span>
                        </div>
                        <div
                            id="preview-body"
                            class="p-6 overflow-y-auto flex-1 article-content font-sans text-text text-base leading-relaxed bg-background"
                        >
                            <!-- Rendered HTML will be injected here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Actions -->
            <div class="flex items-center gap-4 pt-2">
                <button
                    type="button"
                    id="btn-save-bottom"
                    class="font-mono text-sm font-bold text-background bg-primary hover:bg-surface hover:text-primary border border-primary px-5 py-2 transition-colors duration-0 cursor-[crosshair]"
                >
                    [ SAVE ]
                </button>
                <a
                    href="/writer/dashboard/news"
                    class="font-mono text-xs text-accent hover:text-primary border border-muted hover:border-accent px-4 py-2 no-underline cursor-[crosshair] transition-colors duration-0"
                >
                    [ CANCEL ]
                </a>
            </div>
        </div>

        <!-- Footer Nav -->
        <div class="border-t border-muted pt-4 mt-4 flex items-center justify-between font-mono text-xs text-accent">
            <a
                href="/writer/dashboard/news"
                class="hover:text-primary transition-colors duration-0 cursor-[crosshair] no-underline"
            >
                &lt;-- cd ~/writer/dashboard/news
            </a>
            <span class="text-muted">news_editor</span>
        </div>
    </div>

    <!-- Client-Side Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var summaryField = document.getElementById('news-summary');
            var summaryCounter = document.getElementById('summary-counter');
            var alertBox = document.getElementById('alert-box');
            var contentTextarea = document.getElementById('content');

            var splitContainer = document.getElementById('split-container');
            var paneEditor = document.getElementById('pane-editor');
            var panePreview = document.getElementById('pane-preview');
            var splitDivider = document.getElementById('split-divider');
            var previewBody = document.getElementById('preview-body');
            var previewMeta = document.getElementById('preview-meta');
            var charWordCounter = document.getElementById('char-word-counter');
            var btnMobileToggle = document.getElementById('btn-mobile-toggle');

            // --- 1. Summary character counter ---
            summaryField.addEventListener('input', function () {
                var len = summaryField.value.length;
                summaryCounter.textContent = len + '/200';
                if (len > 180) {
                    summaryCounter.className = 'font-mono text-[10px] text-red-400';
                } else {
                    summaryCounter.className = 'font-mono text-[10px] text-muted';
                }
            });

            // --- 2. Marked Parser Setup ---
            var markedParser = null;
            function initMarked() {
                if (window.marked && window.marked.Marked) {
                    markedParser = new window.marked.Marked();
                    markedParser.use({
                        renderer: {
                            heading: function (token) {
                                var text = token.text;
                                var level = token.depth;
                                var cleanText = text.replace(/<[^>]*>/g, '');
                                var slugId = cleanText
                                    .toLowerCase()
                                    .replace(/[^a-z0-9\s-]/g, '')
                                    .replace(/\s+/g, '-');
                                return '<h' + level + ' id="' + slugId + '">' + text + '</h' + level + '>';
                            },
                            table: function (token) {
                                var headerHtml = '';
                                var bodyHtml = '';
                                if (token.header) {
                                    token.header.forEach(function (cell) {
                                        headerHtml += '<th>' + cell.text + '</th>';
                                    });
                                }
                                if (token.rows) {
                                    token.rows.forEach(function (row) {
                                        var rowHtml = '';
                                        row.forEach(function (cell) {
                                            rowHtml += '<td>' + cell.text + '</td>';
                                        });
                                        bodyHtml += '<tr>' + rowHtml + '</tr>';
                                    });
                                }
                                return '<div class="table-container"><table class="markdown-table"><thead><tr>' + headerHtml + '</tr></thead><tbody>' + bodyHtml + '</tbody></table></div>';
                            },
                            hr: function () {
                                return '<hr class="terminal-hr" />';
                            }
                        }
                    });
                }
            }

            function renderMarkdown(content) {
                if (!content || !content.trim()) {
                    return '<p class="text-muted font-mono text-xs italic">[ Konten markdown kosong. Mulai mengetik di editor untuk melihat pratinjau langsung... ]</p>';
                }
                if (!markedParser && window.marked) {
                    initMarked();
                }
                if (markedParser && typeof markedParser.parse === 'function') {
                    return markedParser.parse(content);
                } else if (window.marked && typeof window.marked.parse === 'function') {
                    return window.marked.parse(content);
                }
                return '<pre>' + content.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</pre>';
            }

            // --- 3. Live Preview Debounce (~150ms) ---
            var debounceTimer = null;
            function updateLivePreview() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    var text = contentTextarea.value;
                    previewBody.innerHTML = renderMarkdown(text);
                    var chars = text.length;
                    var words = text.trim() ? text.trim().split(/\s+/).length : 0;
                    if (previewMeta) previewMeta.textContent = words + ' words';
                    if (charWordCounter) charWordCounter.textContent = chars + ' chars | ' + words + ' words';
                }, 150);
            }

            contentTextarea.addEventListener('input', updateLivePreview);

            // --- 4. Scroll Sync ---
            var isSyncingEditor = false;
            var isSyncingPreview = false;

            contentTextarea.addEventListener('scroll', function () {
                if (isSyncingPreview) return;
                isSyncingEditor = true;
                var maxEditorScroll = contentTextarea.scrollHeight - contentTextarea.clientHeight;
                if (maxEditorScroll > 0) {
                    var pct = contentTextarea.scrollTop / maxEditorScroll;
                    var maxPreviewScroll = previewBody.scrollHeight - previewBody.clientHeight;
                    previewBody.scrollTop = pct * maxPreviewScroll;
                }
                setTimeout(function () { isSyncingEditor = false; }, 50);
            });

            previewBody.addEventListener('scroll', function () {
                if (isSyncingEditor) return;
                isSyncingPreview = true;
                var maxPreviewScroll = previewBody.scrollHeight - previewBody.clientHeight;
                if (maxPreviewScroll > 0) {
                    var pct = previewBody.scrollTop / maxPreviewScroll;
                    var maxEditorScroll = contentTextarea.scrollHeight - contentTextarea.clientHeight;
                    contentTextarea.scrollTop = pct * maxEditorScroll;
                }
                setTimeout(function () { isSyncingPreview = false; }, 50);
            });

            // --- 5. Ratio Preset Buttons ---
            function updatePresetHighlight(activeRatio) {
                document.querySelectorAll('.btn-preset').forEach(function (btn) {
                    var r = Number(btn.getAttribute('data-ratio'));
                    if (activeRatio !== null && r === activeRatio) {
                        btn.className = 'btn-preset font-mono text-xs px-2.5 py-1 border border-primary bg-surface text-primary font-bold transition-colors cursor-[crosshair]';
                    } else {
                        btn.className = 'btn-preset font-mono text-xs px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]';
                    }
                });
            }

            document.querySelectorAll('.btn-preset').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (window.innerWidth < 1024) return;
                    var ratio = Number(btn.getAttribute('data-ratio'));
                    paneEditor.style.width = ratio + '%';
                    panePreview.style.width = (100 - ratio) + '%';
                    updatePresetHighlight(ratio);
                });
            });

            // --- 6. Draggable Splitter Handle ---
            var isDragging = false;

            splitDivider.addEventListener('mousedown', function (e) {
                if (window.innerWidth < 1024) return;
                e.preventDefault();
                isDragging = true;
                document.body.style.cursor = 'col-resize';
                document.body.style.userSelect = 'none';
                splitDivider.classList.add('bg-primary/20');
            });

            window.addEventListener('mousemove', function (e) {
                if (!isDragging) return;
                var containerRect = splitContainer.getBoundingClientRect();
                var pointerX = e.clientX - containerRect.left;
                var leftPercent = (pointerX / containerRect.width) * 100;
                if (leftPercent < 15) leftPercent = 15;
                if (leftPercent > 85) leftPercent = 85;

                paneEditor.style.width = leftPercent + '%';
                panePreview.style.width = (100 - leftPercent) + '%';
                updatePresetHighlight(null);
            });

            window.addEventListener('mouseup', function () {
                if (isDragging) {
                    isDragging = false;
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                    splitDivider.classList.remove('bg-primary/20');
                }
            });

            // Touch support for tablets
            splitDivider.addEventListener('touchstart', function () {
                if (window.innerWidth < 1024) return;
                isDragging = true;
                splitDivider.classList.add('bg-primary/20');
            }, { passive: true });

            window.addEventListener('touchmove', function (e) {
                if (!isDragging || !e.touches || !e.touches[0]) return;
                var touch = e.touches[0];
                var containerRect = splitContainer.getBoundingClientRect();
                var pointerX = touch.clientX - containerRect.left;
                var leftPercent = (pointerX / containerRect.width) * 100;
                if (leftPercent < 15) leftPercent = 15;
                if (leftPercent > 85) leftPercent = 85;

                paneEditor.style.width = leftPercent + '%';
                panePreview.style.width = (100 - leftPercent) + '%';
                updatePresetHighlight(null);
            }, { passive: true });

            window.addEventListener('touchend', function () {
                if (isDragging) {
                    isDragging = false;
                    splitDivider.classList.remove('bg-primary/20');
                }
            });

            // --- 7. Mobile Toggle ---
            var isMobilePreviewActive = false;
            var mobileToggleText = document.getElementById('mobile-toggle-text');
            var mobileToggleIcon = document.getElementById('mobile-toggle-icon');

            if (btnMobileToggle) {
                btnMobileToggle.addEventListener('click', function () {
                    isMobilePreviewActive = !isMobilePreviewActive;
                    if (isMobilePreviewActive) {
                        paneEditor.classList.add('hidden');
                        paneEditor.classList.remove('flex');
                        panePreview.classList.remove('hidden');
                        panePreview.classList.add('flex');
                        if (mobileToggleText) mobileToggleText.textContent = 'EDIT';
                        if (mobileToggleIcon) mobileToggleIcon.textContent = '✏️';
                        btnMobileToggle.className = 'lg:hidden flex items-center gap-1.5 font-mono text-xs px-3 py-1 border border-muted bg-surface text-primary hover:border-primary transition-colors cursor-[crosshair] font-bold';
                    } else {
                        paneEditor.classList.remove('hidden');
                        paneEditor.classList.add('flex');
                        panePreview.classList.add('hidden');
                        panePreview.classList.remove('flex');
                        panePreview.classList.add('lg:flex');
                        if (mobileToggleText) mobileToggleText.textContent = 'PREVIEW';
                        if (mobileToggleIcon) mobileToggleIcon.textContent = '👁️';
                        btnMobileToggle.className = 'lg:hidden flex items-center gap-1.5 font-mono text-xs px-3 py-1 border border-primary bg-primary text-background hover:bg-surface hover:text-primary transition-colors cursor-[crosshair] font-bold';
                    }
                });
            }

            window.addEventListener('resize', function () {
                if (window.innerWidth >= 1024) {
                    paneEditor.classList.remove('hidden');
                    paneEditor.classList.add('flex');
                    panePreview.classList.remove('hidden');
                    panePreview.classList.add('lg:flex');
                } else {
                    if (isMobilePreviewActive) {
                        paneEditor.classList.add('hidden');
                        paneEditor.classList.remove('flex');
                        panePreview.classList.remove('hidden');
                        panePreview.classList.add('flex');
                    } else {
                        paneEditor.classList.remove('hidden');
                        paneEditor.classList.add('flex');
                        panePreview.classList.add('hidden');
                        panePreview.classList.remove('flex');
                    }
                }
            });

            // Initialize Preview on page load
            initMarked();
            updateLivePreview();

            // --- 8. Save & Alert Handlers ---
            function showAlert(type, msg) {
                alertBox.className = type === 'error'
                    ? 'border border-red-500/50 bg-red-500/10 text-red-400 p-4 font-mono text-xs'
                    : 'border border-green-500/50 bg-green-500/10 text-green-400 p-4 font-mono text-xs';
                alertBox.textContent = msg;
                alertBox.classList.remove('hidden');
                alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            async function doSave(btn) {
                var title = document.getElementById('news-title').value.trim();
                var summary = summaryField.value.trim();
                var content = document.getElementById('content').value.trim();
                var sourceUrl = document.getElementById('news-source-url').value.trim();
                var sourceName = document.getElementById('news-source-name').value.trim();
                var tagsRaw = document.getElementById('news-tags').value.trim();
                var coverImage = document.getElementById('news-cover').value.trim();
                var id = document.getElementById('news-id').value.trim();
                var draft = document.getElementById('news-draft').checked;
                var publishedAt = document.getElementById('news-published-at').value || new Date().toISOString();

                if (!title || !summary || !content || !sourceUrl || !sourceName) {
                    showAlert('error', '[ERR] Title, Summary, Content, Source URL, dan Source Name wajib diisi.');
                    return;
                }

                if (summary.length > 200) {
                    showAlert('error', '[ERR] Summary maksimal 200 karakter.');
                    return;
                }

                var tags = tagsRaw ? tagsRaw.split(',').map(function (t) { return t.trim(); }).filter(Boolean) : [];

                btn.disabled = true;
                var origText = btn.textContent;
                btn.textContent = '[ SAVING... ]';
                alertBox.classList.add('hidden');

                try {
                    var payload = {
                        id: id,
                        title: title,
                        summary: summary,
                        content: content,
                        sourceUrl: sourceUrl,
                        sourceName: sourceName,
                        tags: tags,
                        coverImage: coverImage || undefined,
                        draft: draft,
                        publishedAt: publishedAt,
                    };

                    var res = await fetch('/api/news', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                    });
                    var data = await res.json();

                    if (res.ok && data.success) {
                        showAlert('success', '[ SUCCESS ] News berhasil disimpan! Mengalihkan...');
                        setTimeout(function () {
                            window.location.href = '/writer/dashboard/news';
                        }, 1000);
                    } else {
                        showAlert('error', '[ERR] ' + (data.error || 'Gagal menyimpan news.'));
                        btn.disabled = false;
                        btn.textContent = origText;
                    }
                } catch (err) {
                    showAlert('error', '[ERR] Koneksi gagal.');
                    btn.disabled = false;
                    btn.textContent = origText;
                }
            }

            document.getElementById('btn-save').addEventListener('click', function () {
                doSave(this);
            });

            document.getElementById('btn-save-bottom').addEventListener('click', function () {
                doSave(this);
            });
        });
    </script>

    <TerminalModal />
</body>
</html>
