---
import '../../../styles/global.css';
import { getSession } from '../../../lib/auth';
import { getPost, getProfileData } from '../../../lib/cms';
import { generatePostSlug } from '../../../lib/utils';
import TerminalModal from '../../../components/TerminalModal.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';

const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/writer');
}

const profile = await getProfileData(session.token);
const activeFavicon = profile.faviconUrl || "/favicon.svg";
const isSvgFavicon = activeFavicon.endsWith('.svg');

const targetSlug = Astro.url.searchParams.get('slug');
let existingPost = null;

if (targetSlug) {
  try {
    existingPost = await getPost(targetSlug, session.token);
  } catch (e) {
    console.error('Error fetching post for edit:', e);
  }
}

const isEditMode = Boolean(existingPost);
const defaultTitle = existingPost ? existingPost.frontmatter.title : '';
const defaultSlug = existingPost ? existingPost.slug : generatePostSlug();
const defaultDescription = existingPost ? existingPost.description || existingPost.frontmatter.description || '' : '';
const defaultCategory = existingPost ? existingPost.frontmatter.category || 'General' : 'General';
const defaultPubDate = existingPost ? existingPost.frontmatter.pubDate : new Date().toISOString().split('T')[0];
const defaultTags = existingPost && existingPost.frontmatter.tags ? existingPost.frontmatter.tags.join(', ') : '';
const defaultDraft = existingPost ? existingPost.frontmatter.draft : false;
const defaultCoverImage = existingPost ? existingPost.frontmatter.coverImage || '' : '';
const defaultContent = existingPost ? existingPost.content : '';
---

<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isEditMode ? `Edit: ${defaultTitle}` : 'Create New Post'} — Writer Editor</title>
    {isSvgFavicon ? (
        <link rel="icon" type="image/svg+xml" href={activeFavicon} />
    ) : (
        <link rel="icon" href={activeFavicon} />
    )}

    <script is:inline>
        (function () {
            var storedTheme = localStorage.getItem('theme') || 'system';
            var isDark =
                storedTheme === 'dark' ||
                (storedTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap"
        rel="stylesheet"
    />

    <!-- Marked Library for Client-Side Live Rendering -->
    <script is:inline src="/vendor/marked.min.js"></script>

    <style is:global>
        :root {
            --color-background: #ffffff;
            --color-surface: #f4f4f5;
            --color-border: #e5e5e5;
            --color-text: #18181b;
            --color-muted: #71717a;
            --color-accent: #52525b;
            --color-primary: #000000;
        }

        html.dark {
            --color-background: #0a0a0a;
            --color-surface: #141414;
            --color-border: #2a2a2a;
            --color-text: #d4d4d4;
            --color-muted: #5a5a5a;
            --color-accent: #8a8a8a;
            --color-primary: #f0f0f0;
        }

        body {
            background-color: var(--color-background);
            color: var(--color-text);
            font-family: "JetBrains Mono", monospace;
        }

        /* Article Content Live Preview Typography & Elements */
        .article-content {
            overflow-wrap: anywhere;
            word-break: break-word;
        }
        .article-content p {
            margin-bottom: 1.5rem;
            line-height: 1.8;
            overflow-wrap: anywhere;
            word-break: break-word;
        }
        .article-content h1 {
            font-family: "JetBrains Mono", monospace;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--color-primary);
            margin-top: 2rem;
            margin-bottom: 1rem;
            border-left: 4px solid var(--color-primary);
            padding-left: 0.75rem;
        }
        .article-content h2 {
            font-family: "JetBrains Mono", monospace;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--color-primary);
            margin-top: 2rem;
            margin-bottom: 0.85rem;
            border-left: 3px solid var(--color-primary);
            padding-left: 0.75rem;
            scroll-margin-top: 2rem;
        }
        .article-content h3 {
            font-family: "JetBrains Mono", monospace;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--color-text);
            margin-top: 1.5rem;
            margin-bottom: 0.75rem;
            scroll-margin-top: 2rem;
        }
        .article-content h4, .article-content h5, .article-content h6 {
            font-family: "JetBrains Mono", monospace;
            font-size: 1rem;
            font-weight: 600;
            color: var(--color-muted);
            margin-top: 1.25rem;
            margin-bottom: 0.5rem;
        }
        .article-content ul, .article-content ol {
            padding-left: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .article-content ul { list-style-type: disc; }
        .article-content ol { list-style-type: decimal; }
        .article-content li {
            margin-bottom: 0.5rem;
            line-height: 1.75;
        }
        .article-content a {
            color: var(--color-primary);
            border-bottom: 1px dashed var(--color-accent);
            text-decoration: none;
            transition: border-color 0.2s ease;
        }
        .article-content a:hover {
            border-color: var(--color-primary);
        }
        .article-content code:not(pre code) {
            font-family: "JetBrains Mono", monospace;
            font-size: 0.875em;
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            padding: 0.15rem 0.4rem;
            color: var(--color-text);
        }
        .article-content pre {
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            padding: 1.25rem;
            overflow-x: auto;
            margin-bottom: 1.5rem;
            font-family: "JetBrains Mono", monospace;
            font-size: 0.875rem;
            line-height: 1.6;
        }
        .article-content pre code {
            border: none;
            padding: 0;
            background: transparent;
            font-size: inherit;
            color: var(--color-text);
        }
        .article-content blockquote {
            border-left: 3px solid var(--color-border);
            background-color: var(--color-surface);
            padding: 1rem 1.25rem;
            color: var(--color-text);
            margin: 1.5rem 0;
            font-style: italic;
        }
        .article-content figure {
            margin: 1.75rem 0;
        }
        .article-content figure img {
            margin: 0;
        }
        .article-content img {
            max-width: 100%;
            height: auto;
            border: 1px solid var(--color-border);
            margin: 1.75rem 0;
            display: block;
            background-color: var(--color-surface);
        }
        .article-content .table-container {
            width: 100%;
            overflow-x: auto;
            margin: 1.5rem 0;
            border: 1px solid var(--color-border);
        }
        .article-content .markdown-table {
            width: 100%;
            border-collapse: collapse;
            font-family: "JetBrains Mono", monospace;
            font-size: 0.875rem;
            text-align: left;
        }
        .article-content .markdown-table th {
            background-color: var(--color-surface);
            color: var(--color-primary);
            font-weight: 700;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--color-border);
            text-transform: uppercase;
        }
        .article-content .markdown-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px dashed var(--color-border);
            color: var(--color-text);
        }
        .article-content .markdown-table tr:hover td {
            background-color: var(--color-surface);
        }
        .article-content .terminal-hr {
            border: none;
            border-top: 1px dashed var(--color-border);
            margin: 2rem 0;
        }
        .article-content kbd {
            font-family: "JetBrains Mono", monospace;
            font-size: 0.75rem;
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            box-shadow: 0 2px 0 var(--color-border);
            padding: 0.15rem 0.4rem;
            color: var(--color-primary);
        }
    </style>
</head>
<body class="min-h-screen bg-background text-text flex justify-center pt-8 sm:pt-12 md:pt-16 lg:pt-20 pb-16 md:pb-24 px-5 sm:px-8 md:px-12 lg:px-16">
    <div class="w-full max-w-7xl flex flex-col gap-6">

        <!-- Nav -->
        <nav class="flex items-center justify-between border-b border-muted pb-4 font-mono text-sm">
            <div class="flex items-center gap-2 text-accent">
                <span class="material-symbols-outlined text-[16px] text-primary">edit_note</span>
                <a href="/writer/dashboard" class="hover:text-primary no-underline text-accent">dashboard</a>
                <span>/</span>
                <span class="text-primary font-bold">{isEditMode ? `edit [${defaultSlug}]` : 'new-post'}</span>
            </div>

            <div class="flex items-center gap-4 text-xs">
                <!-- Theme Selector -->
                <ThemeToggle />

                <a
                    href="/writer/dashboard"
                    class="font-mono text-xs text-accent hover:text-text border border-muted px-3 py-1.5 no-underline cursor-[crosshair]"
                >
                    &lt;-- Cancel &amp; Return
                </a>
            </div>
        </nav>

        <!-- Form Box -->
        <form id="editor-form" class="flex flex-col gap-6">
            <input type="hidden" id="oldSlug" value={defaultSlug} />

            <!-- Action Bar Top -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-surface border border-muted p-4">
                <div class="flex items-center gap-2 font-mono text-xs text-accent">
                    <span class="w-2 h-2 rounded-full bg-green-500 inline-block animate-pulse"></span>
                    <span>Status: <strong id="status-indicator" class="text-primary">{isEditMode ? 'EDITING EXISTING POST' : 'DRAFTING NEW POST'}</strong></span>
                </div>

                <div class="flex items-center gap-3">
                    <button
                        type="button"
                        id="btn-upload-trigger"
                        class="font-mono text-xs text-accent hover:text-primary border border-muted hover:border-primary px-3 py-2 cursor-[crosshair] flex items-center gap-1.5"
                    >
                        <span class="material-symbols-outlined text-base">image</span>
                        <span>[ UPLOAD IMAGE ]</span>
                    </button>
                    <input type="file" id="image-file-input" accept="image/*" class="hidden" />

                    <button
                        type="submit"
                        id="btn-save"
                        class="font-mono text-sm font-bold text-background bg-primary hover:bg-surface hover:text-primary border border-primary px-6 py-2 transition-colors cursor-[crosshair] flex items-center gap-2"
                    >
                        <span class="material-symbols-outlined text-base">save</span>
                        <span>[ COMMIT / SAVE POST ]</span>
                    </button>
                </div>
            </div>

            <div id="alert-box" class="hidden border p-4 font-mono text-xs"></div>

            <!-- Metadata Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-surface border border-muted p-6">
                <!-- Title -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label for="title" class="font-mono text-xs text-accent font-bold">TITLE *</label>
                    <input
                        type="text"
                        id="title"
                        required
                        value={defaultTitle}
                        placeholder="Contoh: Belajar Astro 6 & Tailwind CSS v4"
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Slug with REROLL ID Button -->
                <div class="flex flex-col gap-1.5">
                    <div class="flex items-center justify-between">
                        <label for="slug" class="font-mono text-xs text-accent font-bold">SLUG (URL IDENTIFIER) *</label>
                        <button
                            type="button"
                            id="btn-reroll-slug"
                            class="font-mono text-[10px] text-accent hover:text-primary border border-muted hover:border-primary px-2 py-0.5 cursor-[crosshair] transition-colors"
                            title="Hasilkan ID slug ringkas acak baru (post-YYYYMMDD-xxxxxx)"
                        >
                            [ REROLL ID ]
                        </button>
                    </div>
                    <input
                        type="text"
                        id="slug"
                        required
                        value={defaultSlug}
                        placeholder="post-YYYYMMDD-xxxxxx"
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Category -->
                <div class="flex flex-col gap-1.5">
                    <label for="category" class="font-mono text-xs text-accent font-bold">CATEGORY</label>
                    <input
                        type="text"
                        id="category"
                        value={defaultCategory}
                        placeholder="General, Backend, Linux, DevOps"
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Pub Date -->
                <div class="flex flex-col gap-1.5">
                    <label for="pubDate" class="font-mono text-xs text-accent font-bold">PUBLICATION DATE</label>
                    <input
                        type="date"
                        id="pubDate"
                        value={defaultPubDate}
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Tags -->
                <div class="flex flex-col gap-1.5">
                    <label for="tags" class="font-mono text-xs text-accent font-bold">TAGS (PISAH DENGAN KOMA)</label>
                    <input
                        type="text"
                        id="tags"
                        value={defaultTags}
                        placeholder="astro, tailwind, webdev"
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-sm text-text px-3 py-2"
                    />
                </div>

                <!-- Description -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label for="description" class="font-mono text-xs text-accent font-bold">DESCRIPTION / SUMMARY</label>
                    <textarea
                        id="description"
                        rows="2"
                        placeholder="Ringkasan singkat isi artikel untuk SEO dan preview list..."
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-xs text-text px-3 py-2 resize-y"
                    >{defaultDescription}</textarea>
                </div>

                <!-- Cover Image & Options -->
                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 md:col-span-2 pt-2 border-t border-muted">
                    <div class="flex-1 flex flex-col gap-1 w-full">
                        <label for="coverImage" class="font-mono text-xs text-accent font-bold">COVER IMAGE URL (OPTIONAL)</label>
                        <input
                            type="text"
                            id="coverImage"
                            value={defaultCoverImage}
                            placeholder="/images/posts/sample.png"
                            class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-xs text-text px-3 py-2 w-full"
                        />
                    </div>

                    <label class="flex items-center gap-2 cursor-pointer font-mono text-xs text-accent shrink-0 pt-4 md:pt-0">
                        <input
                            type="checkbox"
                            id="draft"
                            checked={defaultDraft}
                            class="bg-background border-muted text-primary focus:ring-0 w-4 h-4"
                        />
                        <span>Simpan sebagai Draft (Tidak dipublikasikan)</span>
                    </label>
                </div>
            </div>

            <!-- Content Area: Editor + Preview -->
            <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between font-mono text-xs text-accent">
                    <span class="font-bold">MARKDOWN CONTENT</span>
                    <span>Supports Markdown formatting, code blocks & images</span>
                </div>

                <!-- Blog Template Toolbar -->
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-accent bg-surface border border-muted p-2.5">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-bold text-primary">TEMPLATES:</span>
                        <button type="button" class="btn-template text-accent hover:text-primary border border-muted hover:border-primary px-2.5 py-1 cursor-[crosshair] transition-colors" data-template="tutorial">
                            [ Tutorial / Guide ]
                        </button>
                        <button type="button" class="btn-template text-accent hover:text-primary border border-muted hover:border-primary px-2.5 py-1 cursor-[crosshair] transition-colors" data-template="showcase">
                            [ Project Showcase ]
                        </button>
                        <button type="button" class="btn-template text-accent hover:text-primary border border-muted hover:border-primary px-2.5 py-1 cursor-[crosshair] transition-colors" data-template="architecture">
                            [ System Design ]
                        </button>
                        <button type="button" class="btn-template text-accent hover:text-primary border border-muted hover:border-primary px-2.5 py-1 cursor-[crosshair] transition-colors" data-template="note">
                            [ Quick Note ]
                        </button>
                        <button type="button" class="btn-template text-accent hover:text-primary border border-muted hover:border-primary px-2.5 py-1 cursor-[crosshair] transition-colors" data-template="complex">
                            [ Advanced MDX ]
                        </button>
                    </div>
                    <span class="text-muted hidden md:inline">Klik template untuk mengisi outline otomatis</span>
                </div>

                <!-- Live Preview & Split-Pane Toolbar -->
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-accent bg-surface border border-muted p-2.5">
                    <div class="flex items-center gap-3">
                        <span class="font-bold text-primary flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px]">view_column</span>
                            <span>LAYOUT:</span>
                        </span>

                        <!-- Desktop Presets -->
                        <div class="hidden lg:flex items-center gap-1.5" id="preset-container">
                            <button
                                type="button"
                                class="btn-preset font-mono text-xs px-2.5 py-1 border border-primary bg-surface text-primary font-bold transition-colors cursor-[crosshair]"
                                data-ratio="50"
                                title="Bagi rata 50% editor, 50% preview"
                            >
                                [ 50:50 ]
                            </button>
                            <button
                                type="button"
                                class="btn-preset font-mono text-xs px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                                data-ratio="80"
                                title="Fokus editor: 80% editor, 20% preview"
                            >
                                [ Focus Edit ]
                            </button>
                            <button
                                type="button"
                                class="btn-preset font-mono text-xs px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                                data-ratio="20"
                                title="Fokus preview: 20% editor, 80% preview"
                            >
                                [ Focus Preview ]
                            </button>
                        </div>

                        <!-- Mobile Toggle Button -->
                        <button
                            type="button"
                            id="btn-mobile-toggle"
                            class="lg:hidden flex items-center gap-1.5 font-mono text-xs px-3 py-1 border border-primary bg-primary text-background hover:bg-surface hover:text-primary transition-colors cursor-[crosshair] font-bold"
                            title="Beralih ke pratinjau artikel"
                        >
                            <span id="mobile-toggle-icon">👁️</span>
                            <span id="mobile-toggle-text">PREVIEW</span>
                        </button>

                        <div class="h-4 w-px bg-muted hidden sm:block"></div>

                        <!-- Image Cheat Generator Toolbar Button -->
                        <button
                            type="button"
                            id="btn-cheat-image"
                            class="btn-cheat-image flex items-center gap-1.5 font-mono text-xs px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary hover:bg-surface transition-colors cursor-[crosshair]"
                            title="Format gambar markdown kustom (Cheat Tool)"
                        >
                            <span>[ 🖼️ CHEAT: IMG ]</span>
                        </button>
                    </div>

                    <div class="flex items-center gap-4 text-xs font-mono text-muted">
                        <span id="char-word-counter">0 chars | 0 words</span>
                        <span class="hidden md:inline text-[10px] text-muted">&gt; debounced 150ms</span>
                    </div>
                </div>

                <!-- Split-Pane Container -->
                <div id="split-container" class="w-full flex flex-col lg:flex-row border border-muted bg-surface min-h-[550px] lg:h-[700px] relative">
                    <!-- Left: Editor Pane -->
                    <div id="pane-editor" class="w-full lg:w-1/2 flex flex-col min-w-0 bg-surface">
                        <div class="flex items-center justify-between font-mono text-[11px] text-accent px-3 py-1.5 border-b border-muted bg-background/30">
                            <span class="flex items-center gap-1.5 font-bold text-primary">
                                <span class="material-symbols-outlined text-[14px]">edit</span>
                                <span>MARKDOWN SOURCE</span>
                            </span>
                            <span class="text-muted text-[10px]">SCROLL SYNC ON</span>
                        </div>
                        <textarea
                            id="content"
                            placeholder="Tulis artikel blog Anda di sini menggunakan format Markdown..."
                            class="w-full flex-1 min-h-[450px] lg:min-h-0 bg-transparent border-0 focus:outline-none focus:ring-0 font-mono text-sm text-text p-4 resize-none leading-relaxed overflow-y-auto"
                        >{defaultContent}</textarea>
                    </div>

                    <!-- Draggable Divider (Desktop Only) -->
                    <div
                        id="split-divider"
                        class="hidden lg:flex items-center justify-center w-2.5 bg-background hover:bg-surface cursor-col-resize select-none shrink-0 border-x border-muted transition-colors relative group"
                        title="Tarik untuk mengatur rasio editor dan preview"
                    >
                        <div class="w-0.5 h-8 bg-muted group-hover:bg-primary transition-colors"></div>
                    </div>

                    <!-- Right: Preview Pane -->
                    <div id="pane-preview" class="hidden lg:flex w-full lg:w-1/2 flex-col min-w-0 bg-background">
                        <div class="flex items-center justify-between font-mono text-[11px] text-accent px-4 py-1.5 border-b border-muted bg-surface/50">
                            <span class="flex items-center gap-1.5 font-bold text-primary">
                                <span class="material-symbols-outlined text-[14px]">visibility</span>
                                <span>LIVE ARTICLE PREVIEW</span>
                            </span>
                            <span id="preview-meta" class="text-muted text-[10px]">0 words</span>
                        </div>
                        <div
                            id="preview-body"
                            class="p-6 overflow-y-auto flex-1 article-content font-sans text-text text-base leading-relaxed bg-background"
                        >
                            <!-- Rendered HTML will be injected here -->
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Client-Side Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var titleInput = document.getElementById('title');
            var slugInput = document.getElementById('slug');
            var btnRerollSlug = document.getElementById('btn-reroll-slug');
            var editorForm = document.getElementById('editor-form');
            var btnSave = document.getElementById('btn-save');
            var alertBox = document.getElementById('alert-box');
            var btnUploadTrigger = document.getElementById('btn-upload-trigger');
            var imageFileInput = document.getElementById('image-file-input');
            var contentTextarea = document.getElementById('content');

            var splitContainer = document.getElementById('split-container');
            var paneEditor = document.getElementById('pane-editor');
            var panePreview = document.getElementById('pane-preview');
            var splitDivider = document.getElementById('split-divider');
            var previewBody = document.getElementById('preview-body');
            var previewMeta = document.getElementById('preview-meta');
            var charWordCounter = document.getElementById('char-word-counter');
            var btnMobileToggle = document.getElementById('btn-mobile-toggle');

            // --- 1. Short Slug Reroll Handler ---
            function generateClientSlug() {
                var now = new Date();
                var ts = now.toISOString().slice(0, 10).replace(/-/g, '');
                var rand = Math.random().toString(36).substring(2, 8).padEnd(6, '0');
                return 'post-' + ts + '-' + rand;
