                    if (size === 'custom') {
                        if (cheatImgCustomWrap) {
                            cheatImgCustomWrap.classList.remove('hidden');
                            if (cheatImgCustomWidth) cheatImgCustomWidth.focus();
                        }
                    } else {
                        if (cheatImgCustomWrap) {
                            cheatImgCustomWrap.classList.add('hidden');
                        }
                    }
                    updateCheatModalPreview();
                });
            });

            document.querySelectorAll('.btn-cheat-align').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var align = btn.getAttribute('data-align');
                    currentCheatAlign = align;
                    document.querySelectorAll('.btn-cheat-align').forEach(function (b) {
                        b.className = 'btn-cheat-align px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]';
                    });
                    btn.className = 'btn-cheat-align px-2.5 py-1 border border-primary bg-primary text-background font-bold transition-colors cursor-[crosshair]';
                    updateCheatModalPreview();
                });
            });

            if (cheatImgUrl) {
                cheatImgUrl.addEventListener('input', function () {
                    if (cheatImgUrlError && cheatImgUrl.value.trim()) {
                        cheatImgUrlError.classList.add('hidden');
                    }
                    updateCheatModalPreview();
                });
            }

            if (cheatImgAlt) {
                cheatImgAlt.addEventListener('input', updateCheatModalPreview);
            }

            if (cheatImgCaption) {
                cheatImgCaption.addEventListener('input', updateCheatModalPreview);
            }

            if (cheatImgCustomWidth) {
                cheatImgCustomWidth.addEventListener('input', updateCheatModalPreview);
            }

            if (cheatImgInsert) {
                cheatImgInsert.addEventListener('click', function () {
                    var url = (cheatImgUrl && cheatImgUrl.value || '').trim();
                    if (!url) {
                        if (cheatImgUrlError) cheatImgUrlError.classList.remove('hidden');
                        if (cheatImgUrl) cheatImgUrl.focus();
                        return;
                    }

                    var alt = (cheatImgAlt && cheatImgAlt.value || '').trim();
                    var caption = (cheatImgCaption && cheatImgCaption.value || '').trim();
                    var size = currentCheatSize;
                    if (currentCheatSize === 'custom') {
                        var customW = (cheatImgCustomWidth && cheatImgCustomWidth.value || '').trim();
                        size = customW || '480px';
                    }

                    var parts = [];
                    if (alt) parts.push(alt);
                    parts.push(currentCheatAlign);
                    parts.push(size);
                    if (caption) parts.push('caption="' + caption.replace(/"/g, '&quot;') + '"');

                    var syntax = '![' + parts.join(' | ') + '](' + url + ')';

                    var startPos = contentTextarea.selectionStart;
                    var endPos = contentTextarea.selectionEnd;
                    var curVal = contentTextarea.value;
                    var before = curVal.substring(0, startPos);
                    var after = curVal.substring(endPos);

                    var prefix = (before.length > 0 && !before.endsWith('\n')) ? '\n\n' : (before.length > 0 && !before.endsWith('\n\n')) ? '\n' : '';
                    var suffix = (!after.startsWith('\n')) ? '\n\n' : (!after.startsWith('\n\n')) ? '\n' : '';
                    var inserted = prefix + syntax + suffix;

                    contentTextarea.value = before + inserted + after;
                    var newCursorPos = startPos + inserted.length;
                    contentTextarea.selectionStart = newCursorPos;
                    contentTextarea.selectionEnd = newCursorPos;
                    contentTextarea.focus();

                    // Memicu event input agar live preview langsung ter-render
                    contentTextarea.dispatchEvent(new Event('input', { bubbles: true }));

                    closeCheatModal();
                });
            }

            window.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modalImageCheat && !modalImageCheat.classList.contains('hidden')) {
                    e.preventDefault();
                    closeCheatModal();
                }
            });

            // --- 11. Submit Form Logic ---
            editorForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                btnSave.disabled = true;
                btnSave.innerText = '[ SAVING... ]';
                alertBox.classList.add('hidden');

                var slug = slugInput.value.trim();
                var oldSlug = document.getElementById('oldSlug').value;
                var title = titleInput.value.trim();
                var category = document.getElementById('category').value.trim();
                var pubDate = document.getElementById('pubDate').value;
                var tagsStr = document.getElementById('tags').value;
                var description = document.getElementById('description').value.trim();
                var coverImage = document.getElementById('coverImage').value.trim();
                var draft = document.getElementById('draft').checked;
                var content = contentTextarea.value;

                var tags = tagsStr ? tagsStr.split(',').map(function (t) { return t.trim(); }).filter(Boolean) : [];

                var payload = {
                    slug: slug,
                    oldSlug: oldSlug,
                    frontmatter: {
                        title: title,
                        description: description,
                        pubDate: pubDate,
                        category: category,
                        tags: tags,
                        draft: draft,
                        coverImage: coverImage || undefined,
                    },
                    content: content,
                };

                try {
                    var res = await fetch('/api/posts', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                    });
                    var data = await res.json();

                    if (res.ok && data.success) {
                        alertBox.className = 'border border-green-500/50 bg-green-500/10 text-green-400 p-4 font-mono text-xs';
                        alertBox.innerText = '[ SUCCESS ] ' + (data.message || 'Postingan berhasil disimpan!');
                        alertBox.classList.remove('hidden');

                        setTimeout(function () {
                            window.location.href = '/writer/dashboard';
                        }, 1000);
                    } else {
                        alertBox.className = 'border border-red-500/50 bg-red-500/10 text-red-400 p-4 font-mono text-xs';
                        alertBox.innerText = '[ ERR ] ' + (data.error || 'Gagal menyimpan artikel');
                        alertBox.classList.remove('hidden');
                        btnSave.disabled = false;
                        btnSave.innerText = '[ COMMIT / SAVE POST ]';
                    }
                } catch (err) {
                    alertBox.className = 'border border-red-500/50 bg-red-500/10 text-red-400 p-4 font-mono text-xs';
                    alertBox.innerText = '[ ERR ] Terjadi kesalahan jaringan saat menyimpan postingan.';
                    alertBox.classList.remove('hidden');
                    btnSave.disabled = false;
                    btnSave.innerText = '[ COMMIT / SAVE POST ]';
                }
            });
        });
    </script>

    <!-- Modal Image Cheat Generator -->
    <div
        id="modal-image-cheat"
        class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/80 backdrop-blur-xs p-4 hidden select-none"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-image-cheat-title"
    >
        <div
            id="modal-image-cheat-card"
            class="w-full max-w-2xl bg-surface border border-muted shadow-2xl flex flex-col font-mono text-xs max-h-[90vh] overflow-hidden"
        >
            <!-- Titlebar -->
            <div class="flex items-center justify-between border-b border-muted px-4 py-2.5 bg-background select-none">
                <div class="flex items-center gap-2">
                    <span class="inline-block w-2 h-2 bg-primary"></span>
                    <span id="modal-image-cheat-title" class="font-bold text-primary uppercase tracking-wider">
                        &gt; cheat: markdown_image_formatter
                    </span>
                </div>
                <button
                    id="modal-image-cheat-close"
                    type="button"
                    class="text-muted hover:text-primary transition-colors cursor-[crosshair] px-1 font-bold"
                    title="Tutup dialog"
                >
                    [X]
                </button>
            </div>

            <!-- Modal Body (Scrollable) -->
            <div class="p-4 md:p-6 flex flex-col gap-4 overflow-y-auto bg-surface leading-relaxed text-text">
                <!-- Direct Image URL (wajib) -->
                <div class="flex flex-col gap-1.5">
                    <label for="cheat-img-url" class="font-bold text-primary flex items-center justify-between">
                        <span>DIRECT IMAGE URL *</span>
                        <span class="text-[10px] text-muted font-normal">Wajib diisi</span>
                    </label>
                    <input
                        type="text"
                        id="cheat-img-url"
                        placeholder="https://... atau /images/..."
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-xs text-text px-3 py-2 w-full"
                        required
                    />
                    <span id="cheat-img-url-error" class="text-red-400 text-[10px] hidden">&gt; URL gambar tidak boleh kosong!</span>
                </div>

                <!-- Alt Text / Deskripsi (opsional) -->
                <div class="flex flex-col gap-1.5">
                    <label for="cheat-img-alt" class="font-bold text-primary flex items-center justify-between">
                        <span>ALT TEXT / DESKRIPSI (OPTIONAL)</span>
                        <span class="text-[10px] text-muted font-normal">Aksesibilitas &amp; SEO</span>
                    </label>
                    <input
                        type="text"
                        id="cheat-img-alt"
                        placeholder="Deskripsi singkat gambar..."
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-xs text-text px-3 py-2 w-full"
                    />
                </div>

                <!-- Size Preset -->
                <div class="flex flex-col gap-1.5">
                    <span class="font-bold text-primary">PILIHAN UKURAN (SIZE PRESET):</span>
                    <div class="flex flex-wrap items-center gap-1.5" id="cheat-size-buttons">
                        <button
                            type="button"
                            class="btn-cheat-size px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                            data-size="small"
                        >
                            [ S: 240px ]
                        </button>
                        <button
                            type="button"
                            class="btn-cheat-size px-2.5 py-1 border border-primary bg-primary text-background font-bold transition-colors cursor-[crosshair]"
                            data-size="medium"
                        >
                            [ M: 480px ]
                        </button>
                        <button
                            type="button"
                            class="btn-cheat-size px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                            data-size="large"
                        >
                            [ L: 720px ]
                        </button>
                        <button
                            type="button"
                            class="btn-cheat-size px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                            data-size="full"
                        >
                            [ Full: 100% ]
                        </button>
                        <button
                            type="button"
                            class="btn-cheat-size px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                            data-size="custom"
                        >
                            [ Custom ]
                        </button>
                    </div>

                    <!-- Custom Width Input (shown if Custom selected) -->
                    <div id="cheat-img-custom-wrap" class="hidden mt-1.5 flex flex-col gap-1">
                        <div class="flex items-center gap-2">
                            <span class="text-accent">&gt; Custom Width:</span>
                            <input
                                type="text"
                                id="cheat-img-custom-width"
                                placeholder="misal: 360px, 50%, 25rem..."
                                class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-xs text-text px-3 py-1.5 flex-1"
                            />
                        </div>
                        <span class="text-[10px] text-muted">&gt; Format yang didukung: [angka]px, [angka]%, atau [angka]rem</span>
                    </div>
                </div>

                <!-- Alignment -->
                <div class="flex flex-col gap-1.5">
                    <span class="font-bold text-primary">POSISI / ALIGNMENT:</span>
                    <div class="flex items-center gap-1.5" id="cheat-align-buttons">
                        <button
                            type="button"
                            class="btn-cheat-align px-2.5 py-1 border border-primary bg-primary text-background font-bold transition-colors cursor-[crosshair]"
                            data-align="center"
                        >
                            [ Center ]
                        </button>
                        <button
                            type="button"
                            class="btn-cheat-align px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                            data-align="left"
                        >
                            [ Left ]
                        </button>
                        <button
                            type="button"
                            class="btn-cheat-align px-2.5 py-1 border border-muted text-accent hover:border-primary hover:text-primary transition-colors cursor-[crosshair]"
                            data-align="right"
                        >
                            [ Right ]
                        </button>
                    </div>
                </div>

                <!-- Caption / Keterangan (opsional) -->
                <div class="flex flex-col gap-1.5">
                    <label for="cheat-img-caption" class="font-bold text-primary flex items-center justify-between">
                        <span>CAPTION / KETERANGAN (OPTIONAL)</span>
                        <span class="text-[10px] text-muted font-normal">&lt;figcaption&gt;</span>
                    </label>
                    <input
                        type="text"
                        id="cheat-img-caption"
                        placeholder="Keterangan gambar (otomatis menjadi <figcaption>)..."
                        class="bg-background border border-muted focus:border-primary focus:ring-0 font-mono text-xs text-text px-3 py-2 w-full"
                    />
                </div>

                <!-- Live Mini Preview & Markdown Code Box -->
                <div class="flex flex-col gap-2 pt-2 border-t border-muted">
                    <div class="flex items-center justify-between font-mono text-[11px] text-accent">
                        <span class="font-bold text-primary flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[14px]">preview</span>
                            <span>LIVE MINI PREVIEW &amp; KODE MARKDOWN:</span>
                        </span>
                    </div>

                    <!-- Code Output -->
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] text-muted">&gt; Markdown Output:</span>
                        <div
                            id="cheat-img-code-preview"
                            class="bg-background border border-muted p-2.5 font-mono text-[11px] text-primary break-all select-all leading-relaxed"
                        >
                            ![Image | center | medium](https://...)
                        </div>
                    </div>

                    <!-- Visual Render Preview -->
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] text-muted">&gt; Visual Preview:</span>
                        <div
                            id="cheat-img-visual-preview"
                            class="bg-background border border-muted p-4 min-h-[140px] flex items-center justify-center overflow-x-auto"
                        >
                            <span class="text-muted text-xs italic font-mono">[ Masukkan URL gambar di atas untuk melihat pratinjau visual ]</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="border-t border-muted px-4 py-3 bg-background flex items-center justify-end gap-3 font-mono text-xs select-none">
                <button
                    id="modal-image-cheat-cancel"
                    type="button"
                    class="border border-muted hover:border-primary text-accent hover:text-primary px-4 py-2 transition-colors cursor-[crosshair]"
                >
                    [ BATAL ]
                </button>
                <button
                    id="cheat-img-insert"
                    type="button"
                    class="border border-primary bg-primary text-background hover:bg-background hover:text-primary font-bold px-5 py-2 transition-colors cursor-[crosshair] flex items-center gap-1.5"
                >
                    <span class="material-symbols-outlined text-[16px]">add_photo_alternate</span>
                    <span>[ INSERT TO EDITOR ]</span>
                </button>
            </div>
        </div>
    </div>

    <TerminalModal />
</body>
</html>
