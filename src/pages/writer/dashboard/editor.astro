            // --- 2. Custom Markdown Image Formatter Logic (Identical to src/lib/markdown-image.ts) ---
            var IMAGE_WIDTH_PRESETS = {
                small: '240px',
                medium: '480px',
                large: '720px',
                full: '100%'
            };

            var IMAGE_ALIGN_CLASS_MAP = {
                center: 'items-center text-center',
                left: 'items-start text-left',
                right: 'items-end text-right'
            };

            function escapeHtml(str) {
                return (str || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function escapeAttr(str) {
                return (str || '')
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function sanitizeHref(url) {
                if (!url || typeof url !== 'string') return '';
                var trimmed = url.trim();
                var lower = trimmed.toLowerCase();
                if (
                    lower.startsWith('javascript:') ||
                    lower.startsWith('vbscript:') ||
                    (lower.startsWith('data:') && !lower.startsWith('data:image/'))
                ) {
                    return '';
                }
                return escapeAttr(trimmed);
            }

            function parseImageSyntax(text, title) {
                var rawText = (text || '').trim();
                var align = 'center';
                var width = undefined;
                var caption = undefined;

                var textWithoutCaption = rawText;
                var captionRegex = /(?:^|\|)\s*caption=(?:"([^"]*)"|'([^']*)'|([^|]+?))\s*(?=\||$)/i;
                var captionMatch = rawText.match(captionRegex);
                if (captionMatch) {
                    var rawCap = (captionMatch[1] || captionMatch[2] || captionMatch[3] || '').trim();
                    if (rawCap) {
                        caption = rawCap;
                    }
                    textWithoutCaption = rawText.replace(captionRegex, '|').trim();
                }

                if (!caption && title && typeof title === 'string' && title.trim()) {
                    caption = title.trim();
                }

                if (!rawText.includes('|')) {
                    return {
                        cleanAlt: rawText,
                        align: align,
                        width: width,
                        caption: caption
                    };
                }

                var rawTokens = textWithoutCaption.split('|').map(function (t) { return t.trim(); });
                var candidateAlt = rawTokens[0] || '';
                var optionTokens = rawTokens.slice(1);

                for (var i = 0; i < optionTokens.length; i++) {
                    var token = optionTokens[i];
                    if (!token) continue;
                    var lower = token.toLowerCase().replace(/^(?:align|width)\s*=\s*/i, '');

                    if (lower === 'left' || lower === 'right' || lower === 'center') {
                        align = lower;
                        continue;
                    }

                    if (IMAGE_WIDTH_PRESETS[lower]) {
                        width = IMAGE_WIDTH_PRESETS[lower];
                        continue;
                    }

                    if (/^\d+(?:\.\d+)?(?:px|%|rem)$/i.test(lower)) {
                        width = lower;
                        continue;
                    }

                    if (/^caption\s*=/i.test(token)) {
                        var capVal = token.replace(/^caption\s*=\s*/i, '').replace(/^["']|["']$/g, '').trim();
                        if (capVal && !caption) {
                            caption = capVal;
                        }
                        continue;
                    }
                }

                if (candidateAlt) {
                    var candidateLower = candidateAlt.toLowerCase().replace(/^(?:align|width)\s*=\s*/i, '');
                    if (
                        (candidateLower === 'left' || candidateLower === 'right' || candidateLower === 'center') &&
                        align === 'center'
                    ) {
                        align = candidateLower;
                        candidateAlt = '';
                    } else if (IMAGE_WIDTH_PRESETS[candidateLower] && !width) {
                        width = IMAGE_WIDTH_PRESETS[candidateLower];
                        candidateAlt = '';
                    } else if (/^\d+(?:\.\d+)?(?:px|%|rem)$/i.test(candidateLower) && !width) {
                        width = candidateLower;
                        candidateAlt = '';
                    }
                }

                return {
                    cleanAlt: candidateAlt,
                    align: align,
                    width: width,
                    caption: caption
                };
            }

            function renderCustomImage(href, text, title) {
                var parsed = parseImageSyntax(text, title);
                var safeHref = sanitizeHref(href);
                var safeAlt = escapeAttr(parsed.cleanAlt);
                var safeCaption = parsed.caption ? escapeHtml(parsed.caption) : '';

                var containerClass = 'my-6 flex flex-col ' + (IMAGE_ALIGN_CLASS_MAP[parsed.align] || IMAGE_ALIGN_CLASS_MAP.center);
                var imgClass = 'border border-muted bg-surface max-w-full h-auto';

                var style = parsed.width
                    ? 'width: ' + parsed.width + '; max-width: 100%; height: auto;'
                    : 'max-width: 100%; height: auto;';

                var figcaptionHtml = safeCaption
                    ? '\n  <figcaption class="text-xs text-muted mt-2 italic font-mono">&gt; ' + safeCaption + '</figcaption>'
                    : '';

                return '<figure class="' + containerClass + '">\n  <img src="' + safeHref + '" alt="' + safeAlt + '" class="' + imgClass + '" style="' + style + '" loading="lazy" />' + figcaptionHtml + '\n</figure>';
            }

            // --- 3. Marked Parser Setup ---
            var markedParser = null;
            function initMarked() {
                if (window.marked && window.marked.Marked) {
                    markedParser = new window.marked.Marked();
                    markedParser.use({
                        renderer: {
                            heading(token) {
                                var text = token.text;
                                var level = token.depth;
                                var cleanText = text.replace(/<[^>]*>/g, '');
                                var slugId = cleanText
                                    .toLowerCase()
                                    .replace(/[^a-z0-9\s-]/g, '')
                                    .replace(/\s+/g, '-');
                                return '<h' + level + ' id="' + slugId + '">' + text + '</h' + level + '>';
                            },
                            table(token) {
                                var headerHtml = '';
                                var bodyHtml = '';
                                if (token.header) {
                                    token.header.forEach(function (cell) {
                                        headerHtml += '<th>' + cell.text + '</th>';
                                    });
                                }
                                if (token.rows) {
                                    token.rows.forEach(function (row) {
                                        var rowHtml = '';
                                        row.forEach(function (cell) {
                                            rowHtml += '<td>' + cell.text + '</td>';
                                        });
                                        bodyHtml += '<tr>' + rowHtml + '</tr>';
                                    });
                                }
                                return '<div class="table-container"><table class="markdown-table"><thead><tr>' + headerHtml + '</tr></thead><tbody>' + bodyHtml + '</tbody></table></div>';
                            },
                            hr() {
                                return '<hr class="terminal-hr" />';
                            },
                            image(token) {
                                var href = (token && token.href) || '';
                                var text = (token && token.text) || '';
                                var title = (token && token.title) || null;
                                return renderCustomImage(href, text, title);
                            }
                        }
                    });
                }
            }

            function renderMarkdown(content) {
                if (!content || !content.trim()) {
                    return '<p class="text-muted font-mono text-xs italic">[ Konten markdown kosong. Mulai mengetik di editor untuk melihat pratinjau langsung... ]</p>';
                }
                if (!markedParser && window.marked) {
                    initMarked();
                }
                if (markedParser && typeof markedParser.parse === 'function') {
                    return markedParser.parse(content);
                } else if (window.marked && typeof window.marked.parse === 'function') {
                    return window.marked.parse(content);
                }
                return '<pre>' + content.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</pre>';
            }

