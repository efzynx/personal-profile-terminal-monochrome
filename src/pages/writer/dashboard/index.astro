---
import { getSession } from '../../../lib/auth';
import { listPosts, getProfileData } from '../../../lib/cms';

const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/writer');
}

const profile = await getProfileData(session.token);
const activeFavicon = profile.faviconUrl || "/favicon.svg";
const isSvgFavicon = activeFavicon.endsWith('.svg');
const promptPrefix = profile.terminalPrompt || `${session.user}@tux`;

let posts = [];
let fetchError = '';
try {
  posts = await listPosts(session.token);
} catch (err: any) {
  fetchError = err.message || 'Gagal memuat daftar artikel';
}
---

<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Writer Dashboard — Ahmad Fauzan Adiman</title>
    {isSvgFavicon ? (
        <link rel="icon" type="image/svg+xml" href={activeFavicon} />
    ) : (
        <link rel="icon" href={activeFavicon} />
    )}

    <script is:inline>
        (function () {
            var storedTheme = localStorage.getItem('theme') || 'system';
            var isDark =
                storedTheme === 'dark' ||
                (storedTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400&family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap"
        rel="stylesheet"
    />

    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script is:inline id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary:    "var(--color-primary)",
                        background: "var(--color-background)",
                        surface:    "var(--color-surface)",
                        border:     "var(--color-border)",
                        text:       "var(--color-text)",
                        muted:      "var(--color-muted)",
                        accent:     "var(--color-accent)",
                    },
                    fontFamily: {
                        mono: ["JetBrains Mono", "monospace"],
                        sans: ["IBM Plex Sans", "sans-serif"],
                    },
                    borderRadius: {
                        DEFAULT: "0px", lg: "0px", xl: "0px", full: "0px",
                    },
                },
            },
        };
    </script>
    <style is:global>
        :root {
            --color-background: #ffffff;
            --color-surface: #f4f4f5;
            --color-border: #e5e5e5;
            --color-text: #18181b;
            --color-muted: #71717a;
            --color-accent: #52525b;
            --color-primary: #000000;
        }

        html.dark {
            --color-background: #000000;
            --color-surface: #0a0a0a;
            --color-border: #444444;
            --color-text: #e0e0e0;
            --color-muted: #666666;
            --color-accent: #888888;
            --color-primary: #ffffff;
        }

        body {
            background-color: var(--color-background);
            color: var(--color-text);
            font-family: "JetBrains Mono", monospace;
        }
    </style>
</head>
<body class="min-h-screen bg-background text-text flex justify-center py-10 px-4 md:px-10">
    <div class="w-full max-w-5xl flex flex-col gap-6">

        <!-- Top Nav Bar -->
        <nav class="flex flex-wrap items-center justify-between gap-4 font-mono text-sm border-b border-muted pb-4">
            <div class="flex items-center gap-2 text-accent">
                <span class="material-symbols-outlined text-[16px] text-primary">terminal</span>
                <span>{promptPrefix}:~$</span>

                <span class="text-primary font-bold">cd ~/writer/dashboard</span>
            </div>

            <div class="flex items-center gap-4 text-xs">
                <div class="flex items-center gap-2 text-accent border border-muted px-3 py-1">
                    {session.avatarUrl && <img src={session.avatarUrl} alt="User" class="w-4 h-4 rounded-full" />}
                    <span>user: <strong class="text-primary">{session.user}</strong></span>
                </div>

                <a
                    href="/api/auth/logout"
                    class="font-mono text-xs text-red-400 hover:text-red-300 border border-red-500/40 hover:border-red-400 px-3 py-1 no-underline transition-colors duration-0 cursor-[crosshair]"
                >
                    [ LOGOUT ]
                </a>
            </div>
        <!-- Admin Sub-Menu Tabs -->
        <div class="flex items-center gap-2 font-mono text-xs border-b border-muted pb-2">
            <a
                href="/writer/dashboard"
                class="px-4 py-2 text-primary font-bold bg-surface border border-muted no-underline cursor-[crosshair]"
            >
                [ 📝 Posts CMS ]
            </a>
            <a
                href="/writer/dashboard/profile"
                class="px-4 py-2 text-accent hover:text-primary border border-transparent hover:border-muted no-underline cursor-[crosshair]"
            >
                [ 👤 Profile Settings ]
            </a>
            <a
                href="/writer/dashboard/settings"
                class="px-4 py-2 text-accent hover:text-primary border border-transparent hover:border-muted no-underline cursor-[crosshair]"
            >
                [ ⚙️ Site Settings ]
            </a>
        </div>


        <!-- Header Block -->

        <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 py-2">
            <div>
                <h1 class="font-mono text-2xl md:text-3xl font-bold text-primary tracking-tight uppercase">Blog Posts Management</h1>
                <p class="font-mono text-xs text-muted mt-1">Total {posts.length} artikel terdaftar dalam koleksi blog.</p>
            </div>

            <a
                href="/writer/dashboard/editor"
                class="font-mono text-sm font-bold text-background bg-primary hover:bg-surface hover:text-primary border border-primary px-5 py-2.5 transition-colors duration-0 cursor-[crosshair] flex items-center gap-2 no-underline shrink-0"
            >
                <span class="material-symbols-outlined text-base">add</span>
                <span>[ CREATE NEW POST ]</span>
            </a>
        </header>

        {fetchError && (
            <div class="border border-red-500/50 bg-red-500/10 text-red-400 p-4 font-mono text-xs">
                [ERR] {fetchError}
            </div>
        )}

        <!-- Posts List -->
        <main class="flex flex-col gap-3 mt-2">
            {posts.length === 0 ? (
                <div class="border border-dashed border-muted p-12 text-center text-muted font-mono text-sm">
                    Belum ada artikel. Klik <strong>[ CREATE NEW POST ]</strong> untuk membuat artikel pertama Anda.
                </div>
            ) : (
                <div class="border border-muted divide-y divide-muted bg-surface">
                    {posts.map((post) => (
                        <div class="p-4 md:p-5 flex flex-col md:flex-row md:items-center justify-between gap-4 group hover:bg-background transition-colors duration-0">
                            <div class="flex flex-col gap-1.5 max-w-2xl">
                                <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
                                    <span class="text-accent">{post.frontmatter.pubDate}</span>
                                    <span class="text-muted">|</span>
                                    <span class="text-primary font-bold">[{post.frontmatter.category || 'General'}]</span>
                                    {post.frontmatter.draft ? (
                                        <span class="px-2 py-0.5 text-[10px] bg-yellow-500/20 text-yellow-300 border border-yellow-500/40">DRAFT</span>
                                    ) : (
                                        <span class="px-2 py-0.5 text-[10px] bg-green-500/20 text-green-300 border border-green-500/40">PUBLISHED</span>
                                    )}
                                </div>
                                <h2 class="font-mono text-base md:text-lg font-bold text-text group-hover:text-primary transition-colors">
                                    {post.frontmatter.title}
                                </h2>
                                <p class="font-sans text-xs text-muted line-clamp-1">
                                    {post.frontmatter.description || post.content.substring(0, 100)}
                                </p>
                            </div>

                            <!-- Actions -->
                            <div class="flex items-center gap-2 shrink-0 font-mono text-xs">
                                <a
                                    href={`/blog/posts/${post.slug}`}
                                    target="_blank"
                                    class="text-accent hover:text-primary border border-muted hover:border-accent px-3 py-1.5 no-underline transition-colors cursor-[crosshair]"
                                >
                                    [ View ]
                                </a>
                                <a
                                    href={`/writer/dashboard/editor?slug=${post.slug}`}
                                    class="text-primary hover:bg-surface border border-primary px-3 py-1.5 no-underline font-bold transition-colors cursor-[crosshair]"
                                >
                                    [ Edit ]
                                </a>
                                <button
                                    type="button"
                                    data-delete-slug={post.slug}
                                    class="btn-delete text-red-400 hover:text-red-300 border border-red-500/40 hover:border-red-400 px-3 py-1.5 transition-colors cursor-[crosshair]"
                                >
                                    [ Delete ]
                                </button>
                            </div>
                        </div>
                    ))}
                </div>
            )}
        </main>
    </div>

    <!-- Client-Side Delete Logic -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteButtons = document.querySelectorAll('[data-delete-slug]');
            deleteButtons.forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var slug = btn.getAttribute('data-delete-slug');
                    if (!slug) return;

                    var confirmDelete = confirm('Apakah Anda yakin ingin menghapus artikel "' + slug + '"?');
                    if (!confirmDelete) return;

                    try {
                        btn.disabled = true;
                        btn.textContent = '[ Deleting... ]';
                        var res = await fetch('/api/posts/' + slug, {
                            method: 'DELETE',
                        });
                        var data = await res.json();

                        if (res.ok && data.success) {
                            window.location.reload();
                        } else {
                            alert('Gagal menghapus: ' + (data.error || data.message || 'Unknown error'));
                            btn.disabled = false;
                            btn.textContent = '[ Delete ]';
                        }
                    } catch (err) {
                        alert('Error koneksi saat menghapus.');
                        btn.disabled = false;
                        btn.textContent = '[ Delete ]';
                    }
                });
            });
        });
    </script>
</body>
</html>
