---
import { getSession } from '../../../lib/auth';
import { getProfileData } from '../../../lib/cms';

const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/writer');
}

let profile = await getProfileData(session.token);
const promptPrefix = profile.terminalPrompt || `${session.user}@tux`;
const activeFavicon = profile.faviconUrl || "/favicon.svg";
const isSvgFavicon = activeFavicon.endsWith('.svg');
const cloudinaryStatusParam = Astro.url.searchParams.get('cloudinary');
---

<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Site Settings — Writer Admin</title>
    {isSvgFavicon ? (
        <link rel="icon" type="image/svg+xml" href={activeFavicon} />
    ) : (
        <link rel="icon" href={activeFavicon} />
    )}

    <script is:inline>
        (function () {
            var storedTheme = localStorage.getItem('theme') || 'system';
            var isDark =
                storedTheme === 'dark' ||
                (storedTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400&family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap"
        rel="stylesheet"
    />

    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script is:inline id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary:    "var(--color-primary)",
                        background: "var(--color-background)",
                        surface:    "var(--color-surface)",
                        border:     "var(--color-border)",
                        text:       "var(--color-text)",
                        muted:      "var(--color-muted)",
                        accent:     "var(--color-accent)",
                    },
                    fontFamily: {
                        mono: ["JetBrains Mono", "monospace"],
                        sans: ["IBM Plex Sans", "sans-serif"],
                    },
                    borderRadius: {
                        DEFAULT: "0px", lg: "0px", xl: "0px", full: "0px",
                    },
                },
            },
        };
    </script>
    <style is:global>
        :root {
            --color-background: #ffffff;
            --color-surface: #f4f4f5;
            --color-border: #e5e5e5;
            --color-text: #18181b;
            --color-muted: #71717a;
            --color-accent: #52525b;
            --color-primary: #000000;
        }

        html.dark {
            --color-background: #0a0a0a;
            --color-surface: #141414;
            --color-border: #2a2a2a;
            --color-text: #d4d4d4;
            --color-muted: #5a5a5a;
            --color-accent: #8a8a8a;
            --color-primary: #f0f0f0;
        }

        body {
            background-color: var(--color-background);
            color: var(--color-text);
            font-family: "JetBrains Mono", monospace;
        }

        /* Theme Selector Active State */
        .theme-btn.active {
            color: var(--color-primary);
            font-weight: 700;
            text-decoration: underline;
        }
    </style>
</head>
<body class="min-h-screen bg-background text-text flex justify-center py-10 px-4 md:px-8 lg:px-12">
    <div class="w-full max-w-7xl flex flex-col gap-6">

        <!-- Top Nav Bar -->
        <nav class="flex flex-wrap items-center justify-between gap-4 font-mono text-sm border-b border-muted pb-4">
            <div class="flex items-center gap-2 text-accent">
                <span class="material-symbols-outlined text-[16px] text-primary">terminal</span>
                <span>{promptPrefix}:~$</span>
                <span class="text-primary font-bold">cd ~/writer/settings</span>
            </div>

            <div class="flex items-center gap-4 text-xs">
                <!-- Theme Selector -->
                <div class="flex items-center gap-1 font-mono text-xs text-accent border border-muted px-2 py-1 select-none">
                    <span class="text-muted mr-1 hidden sm:inline">&gt; mode:</span>
                    <button type="button" data-theme-btn="system" class="theme-btn hover:text-primary transition-colors duration-0 cursor-[crosshair] px-1" title="System theme">sys</button>
                    <span class="text-muted">|</span>
                    <button type="button" data-theme-btn="dark" class="theme-btn hover:text-primary transition-colors duration-0 cursor-[crosshair] px-1" title="Dark theme">dark</button>
                    <span class="text-muted">|</span>
                    <button type="button" data-theme-btn="light" class="theme-btn hover:text-primary transition-colors duration-0 cursor-[crosshair] px-1" title="Light theme">light</button>
                </div>

                <div class="flex items-center gap-2 text-accent border border-muted px-3 py-1">
                    {session.avatarUrl && <img src={session.avatarUrl} alt="User" class="w-4 h-4 rounded-full" />}
                    <span>user: <strong class="text-primary">{session.user}</strong></span>
                </div>

                <a
                    href="/api/auth/logout"
                    class="font-mono text-xs text-red-400 hover:text-red-300 border border-red-500/40 hover:border-red-400 px-3 py-1 no-underline transition-colors cursor-[crosshair]"
                >
                    [ LOGOUT ]
                </a>
            </div>
        </nav>

        <!-- Admin Sub-Menu Tabs -->
        <div class="flex items-center gap-2 font-mono text-xs border-b border-muted pb-2">
            <a
                href="/writer/dashboard"
                class="px-4 py-2 text-accent hover:text-primary border border-transparent hover:border-muted no-underline cursor-[crosshair]"
            >
                [ <span class="material-symbols-outlined text-[12px] align-middle">article</span> Posts CMS ]
            </a>
            <a
                href="/writer/dashboard/news"
                class="px-4 py-2 text-accent hover:text-primary border border-transparent hover:border-muted no-underline cursor-[crosshair]"
            >
                [ <span class="material-symbols-outlined text-[12px] align-middle">newspaper</span> News ]
            </a>
            <a
                href="/writer/dashboard/profile"
                class="px-4 py-2 text-accent hover:text-primary border border-transparent hover:border-muted no-underline cursor-[crosshair]"
            >
                [ <span class="material-symbols-outlined text-[12px] align-middle">person</span> Profile Settings ]
            </a>
            <a
                href="/writer/dashboard/settings"
                class="px-4 py-2 text-primary font-bold bg-surface border border-muted no-underline cursor-[crosshair]"
            >
                [ <span class="material-symbols-outlined text-[12px] align-middle">settings</span> Site Settings ]
            </a>
        </div>

        <!-- Header Block -->
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 py-2">
            <div>
                <h1 class="font-mono text-2xl md:text-3xl font-bold text-primary tracking-tight uppercase">Site Settings & Favicon</h1>
                <p class="font-mono text-xs text-muted mt-1">Konfigurasi ikon favicon dan pengelolaan aset media situs.</p>
            </div>
        </header>

        <div id="alert-box" class="hidden border p-4 font-mono text-xs"></div>

        <div class="flex flex-col gap-6">

            <!-- Custom Favicon / Site Icon Card -->
            <div class="bg-surface border border-muted p-6 flex flex-col gap-6">
                <h2 class="font-mono text-base font-bold text-primary border-b border-muted pb-2 uppercase">&gt; Custom Favicon / Site Icon</h2>

                <div class="grid grid-cols-1 md:grid-cols-[140px_1fr] gap-6 items-start">
                    <!-- Favicon Preview & Upload Button -->
                    <div class="flex flex-col items-center gap-3">
                        <div class="w-20 h-20 border border-muted p-3 flex items-center justify-center bg-background">
                            <img
                                id="favicon-preview"
                                src={profile.faviconUrl || '/favicon.svg'}
                                alt="Site Favicon"
                                class="w-12 h-12 object-contain"
                            />
                        </div>
                        <input type="hidden" id="faviconUrl" value={profile.faviconUrl || '/favicon.svg'} />
                        <button
                            type="button"
                            id="btn-upload-favicon"
                            class="w-full font-mono text-xs text-accent hover:text-primary border border-muted hover:border-primary px-2 py-1.5 cursor-[crosshair] text-center"
                        >
                            [ UPLOAD FAVICON ]
                        </button>
                        <input type="file" id="favicon-file-input" accept=".svg,.png,.ico,.webp" class="hidden" />
                    </div>

                    <!-- Guidelines & Recommendations -->
                    <div class="flex flex-col gap-4">
                        <div class="bg-background border border-muted p-4 font-mono text-xs space-y-2">
                            <p class="text-primary font-bold border-b border-muted pb-1">
                                Petunjuk Format & Rekomendasi Optimal:
                            </p>
                            <ul class="list-disc list-inside text-accent space-y-1.5 leading-relaxed pl-1">
                                <li>
                                    <strong class="text-primary">Format Rekomendasi Utama (Paling Optimal)</strong>: <code class="bg-surface px-1 text-primary">SVG</code> (Vector - selalu tajam di layar Retina/4K, super ringan &lt; 5 KB).
                                </li>
                                <li>
                                    <strong class="text-primary">Format Rekomendasi Alternatif</strong>: <code class="bg-surface px-1 text-primary">PNG</code> transparan dengan dimensi <code class="bg-surface px-1 text-primary">32x32</code>, <code class="bg-surface px-1 text-primary">64x64</code>, atau <code class="bg-surface px-1 text-primary">128x128</code> px.
                                </li>
                                <li>
                                    <strong class="text-primary">Format Diizinkan</strong>: <code class="bg-surface px-1 text-accent">.svg</code>, <code class="bg-surface px-1 text-accent">.png</code>, <code class="bg-surface px-1 text-accent">.ico</code>, <code class="bg-surface px-1 text-accent">.webp</code>.
                                </li>
                                <li>
                                    <strong class="text-red-400">Batasan Maksimal Ukuran File</strong>: Maksimal <strong class="text-red-400">500 KB</strong> (0.5 MB). File lebih besar akan ditolak otomatis oleh sistem.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- API Key Management Card -->
            <div class="bg-surface border border-muted p-6 flex flex-col gap-6">
                <h2 class="font-mono text-base font-bold text-primary border-b border-muted pb-2 uppercase">&gt; API Key — Integrasi Eksternal</h2>

                <div class="flex flex-col gap-4">
                    <div class="bg-background border border-muted p-4 font-mono text-xs space-y-2">
                        <p class="text-primary font-bold border-b border-muted pb-1">
                            Tentang API Key
                        </p>
                        <ul class="list-disc list-inside text-accent space-y-1.5 leading-relaxed pl-1">
                            <li>API key memungkinkan <strong class="text-primary">agent/bot eksternal</strong> mengakses endpoint <code class="bg-surface px-1 text-primary">/api/posts</code> tanpa login GitHub OAuth.</li>
                            <li>Gunakan header <code class="bg-surface px-1 text-primary">Authorization: Bearer &lt;API_KEY&gt;</code> untuk autentikasi.</li>
                            <li>API key <strong class="text-red-400">hanya ditampilkan sekali</strong> saat digenerate — simpan di tempat aman.</li>
                            <li>Kamu bisa <strong class="text-primary">menonaktifkan</strong> tanpa menghapus, lalu mengaktifkan kembali kapan saja.</li>
                        </ul>
                    </div>

                    <!-- Status & Controls -->
                    <div id="apikey-status" class="font-mono text-xs text-muted">
                        Memuat status API key...
                    </div>

                    <!-- Generated Key Display (hidden by default) -->
                    <div id="apikey-generated" class="hidden bg-background border border-green-500/40 p-4 font-mono text-xs">
                        <p class="text-green-400 font-bold mb-2">[ API KEY BARU — SALIN SEKARANG! ]</p>
                        <div class="flex items-center gap-2">
                            <input
                                type="text"
                                id="apikey-full-value"
                                readonly
                                class="flex-1 bg-surface border border-muted px-3 py-2 text-primary font-mono text-xs select-all"
                            />
                            <button
                                type="button"
                                id="btn-copy-apikey"
                                class="font-mono text-xs text-accent hover:text-primary border border-muted hover:border-primary px-3 py-2 cursor-[crosshair] whitespace-nowrap"
                            >
                                [ COPY ]
                            </button>
                        </div>
                        <p class="text-red-400 mt-2">Key ini TIDAK akan ditampilkan lagi. Pastikan sudah disalin.</p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap gap-3" id="apikey-actions">
                        <button
                            type="button"
                            id="btn-generate-apikey"
                            class="font-mono text-xs text-accent hover:text-primary border border-muted hover:border-primary px-4 py-2 cursor-[crosshair]"
                        >
                            [ GENERATE API KEY ]
                        </button>
                        <button
                            type="button"
                            id="btn-toggle-apikey"
                            class="hidden font-mono text-xs text-accent hover:text-primary border border-muted hover:border-primary px-4 py-2 cursor-[crosshair]"
                        >
                            [ TOGGLE ]
                        </button>
                        <button
                            type="button"
                            id="btn-delete-apikey"
                            class="hidden font-mono text-xs text-red-400 hover:text-red-300 border border-red-500/40 hover:border-red-400 px-4 py-2 cursor-[crosshair]"
                        >
                            [ HAPUS API KEY ]
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const alertBox = document.getElementById('alert-box');
            const btnUploadFavicon = document.getElementById('btn-upload-favicon');
            const faviconFileInput = document.getElementById('favicon-file-input');
            const faviconPreview = document.getElementById('favicon-preview');
            const faviconUrlInput = document.getElementById('faviconUrl');

            function showAlert(message, isError = false) {
                alertBox.classList.remove('hidden', 'bg-green-500/10', 'border-green-500/40', 'text-green-400', 'bg-red-500/10', 'border-red-500/40', 'text-red-400');
                if (isError) {
                    alertBox.classList.add('bg-red-500/10', 'border-red-500/40', 'text-red-400');
                    alertBox.innerHTML = `[ ERROR ] ${message}`;
                } else {
                    alertBox.classList.add('bg-green-500/10', 'border-green-500/40', 'text-green-400');
                    alertBox.innerHTML = `[ SUCCESS ] ${message}`;
                }
                alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            // Upload Favicon
            btnUploadFavicon?.addEventListener('click', () => faviconFileInput?.click());
            faviconFileInput?.addEventListener('change', async (e) => {
                const file = e.target.files?.[0];
                if (!file) return;

                if (file.size > 500 * 1024) {
                    showAlert(`Ukuran file terlalu besar (${(file.size / 1024).toFixed(1)} KB). Maksimal ukuran favicon adalah 500 KB.`, true);
                    return;
                }

                btnUploadFavicon.innerText = '[ UPLOADING... ]';
                btnUploadFavicon.disabled = true;

                const formData = new FormData();
                formData.append('favicon', file);

                try {
                    const res = await fetch('/api/profile', {
                        method: 'POST',
                        body: formData,
                    });
                    const data = await res.json();
                    if (res.ok && data.faviconUrl) {
                        faviconPreview.src = data.faviconUrl;
                        faviconUrlInput.value = data.faviconUrl;
                        showAlert('Favicon situs berhasil diunggah!');
                    } else {
                        showAlert(data.error || 'Gagal mengunggah favicon.', true);
                    }
                } catch (err) {
                    showAlert('Terjadi kesalahan koneksi saat mengunggah favicon.', true);
                } finally {
                    btnUploadFavicon.innerText = '[ UPLOAD FAVICON ]';
                    btnUploadFavicon.disabled = false;
                }
            });

            // ========== API KEY MANAGEMENT ==========
            const apikeyStatus = document.getElementById('apikey-status');
            const apikeyGenerated = document.getElementById('apikey-generated');
            const apikeyFullValue = document.getElementById('apikey-full-value');
            const btnGenerate = document.getElementById('btn-generate-apikey');
            const btnToggle = document.getElementById('btn-toggle-apikey');
            const btnDelete = document.getElementById('btn-delete-apikey');
            const btnCopy = document.getElementById('btn-copy-apikey');

            let currentEnabled = false;

            async function loadApiKeyStatus() {
                try {
                    const res = await fetch('/api/settings/apikey');
                    const data = await res.json();

                    if (!data.exists) {
                        apikeyStatus.innerHTML = '<span class="text-muted">Belum ada API key. Generate untuk mulai menggunakan integrasi agent.</span>';
                        btnGenerate.innerText = '[ GENERATE API KEY ]';
                        btnToggle.classList.add('hidden');
                        btnDelete.classList.add('hidden');
                    } else if (data.isEnvBased) {
                        apikeyStatus.innerHTML = `
                            <div class="bg-background border border-muted p-3 space-y-1">
                                <p><span class="text-primary font-bold">Status:</span> <span class="text-green-400">● AKTIF (via ENV)</span></p>
                                <p><span class="text-primary font-bold">Key:</span> <code class="bg-surface px-1 text-accent">${data.maskedKey}</code></p>
                                <p class="text-muted">Dikelola via environment variable CMS_API_KEY — tidak bisa diubah dari UI.</p>
                            </div>
                        `;
                        btnGenerate.classList.add('hidden');
                        btnToggle.classList.add('hidden');
                        btnDelete.classList.add('hidden');
                    } else {
                        currentEnabled = data.enabled;
                        const statusColor = data.enabled ? 'text-green-400' : 'text-red-400';
                        const statusText = data.enabled ? '● AKTIF' : '○ NONAKTIF';
                        apikeyStatus.innerHTML = `
                            <div class="bg-background border border-muted p-3 space-y-1">
                                <p><span class="text-primary font-bold">Status:</span> <span class="${statusColor}">${statusText}</span></p>
                                <p><span class="text-primary font-bold">Key:</span> <code class="bg-surface px-1 text-accent">${data.maskedKey}</code></p>
                                <p><span class="text-primary font-bold">Dibuat:</span> <span class="text-accent">${new Date(data.createdAt).toLocaleString('id-ID')}</span></p>
                            </div>
                        `;
                        btnGenerate.innerText = '[ REGENERATE KEY ]';
                        btnToggle.classList.remove('hidden');
                        btnToggle.innerText = data.enabled ? '[ NONAKTIFKAN ]' : '[ AKTIFKAN ]';
                        btnDelete.classList.remove('hidden');
                    }
                } catch (err) {
                    apikeyStatus.innerHTML = '<span class="text-red-400">Gagal memuat status API key.</span>';
                }
            }

            // Generate / Regenerate
            btnGenerate?.addEventListener('click', async () => {
                const confirmMsg = btnGenerate.innerText.includes('REGENERATE')
                    ? 'Key lama akan diganti dan tidak bisa dipakai lagi. Lanjutkan?'
                    : 'Generate API key baru?';

                if (!confirm(confirmMsg)) return;

                btnGenerate.innerText = '[ GENERATING... ]';
                btnGenerate.disabled = true;

                try {
                    const res = await fetch('/api/settings/apikey', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'generate' }),
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        // Tampilkan full key
                        apikeyFullValue.value = data.key;
                        apikeyGenerated.classList.remove('hidden');
                        showAlert('API key berhasil digenerate! Salin dan simpan key di bawah.');
                        await loadApiKeyStatus();
                    } else {
                        showAlert(data.error || 'Gagal generate API key.', true);
                    }
                } catch (err) {
                    showAlert('Terjadi kesalahan koneksi.', true);
                } finally {
                    btnGenerate.disabled = false;
                }
            });

            // Toggle
            btnToggle?.addEventListener('click', async () => {
                const newState = !currentEnabled;
                const label = newState ? 'mengaktifkan' : 'menonaktifkan';

                btnToggle.innerText = '[ PROCESSING... ]';
                btnToggle.disabled = true;

                try {
                    const res = await fetch('/api/settings/apikey', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'toggle', enabled: newState }),
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        showAlert(`API key berhasil di${label}!`);
                        await loadApiKeyStatus();
                    } else {
                        showAlert(data.error || `Gagal ${label} API key.`, true);
                    }
                } catch (err) {
                    showAlert('Terjadi kesalahan koneksi.', true);
                } finally {
                    btnToggle.disabled = false;
                }
            });

            // Delete
            btnDelete?.addEventListener('click', async () => {
                if (!confirm('Hapus API key? Agent yang menggunakan key ini tidak akan bisa mengakses API lagi.')) return;

                btnDelete.innerText = '[ DELETING... ]';
                btnDelete.disabled = true;

                try {
                    const res = await fetch('/api/settings/apikey', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'delete' }),
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        apikeyGenerated.classList.add('hidden');
                        showAlert('API key berhasil dihapus.');
                        await loadApiKeyStatus();
                    } else {
                        showAlert(data.error || 'Gagal menghapus API key.', true);
                    }
                } catch (err) {
                    showAlert('Terjadi kesalahan koneksi.', true);
                } finally {
                    btnDelete.disabled = false;
                }
            });

            // Copy
            btnCopy?.addEventListener('click', () => {
                apikeyFullValue.select();
                navigator.clipboard.writeText(apikeyFullValue.value).then(() => {
                    btnCopy.innerText = '[ OK — COPIED ]';
                    setTimeout(() => { btnCopy.innerText = '[ COPY ]'; }, 2000);
                }).catch(() => {
                    document.execCommand('copy');
                    btnCopy.innerText = '[ OK — COPIED ]';
                    setTimeout(() => { btnCopy.innerText = '[ COPY ]'; }, 2000);
                });
            });

            // Load status on page load
            loadApiKeyStatus();
        });
    </script>

    <!-- Runtime Theme Interactivity Script -->
    <script is:inline>
        (function () {
            function updateThemeUI(theme) {
                var buttons = document.querySelectorAll('[data-theme-btn]');
                buttons.forEach(function (btn) {
                    var btnTheme = btn.getAttribute('data-theme-btn');
                    if (btnTheme === theme) {
                        btn.classList.add('active');
                        btn.setAttribute('aria-pressed', 'true');
                    } else {
                        btn.classList.remove('active');
                        btn.setAttribute('aria-pressed', 'false');
                    }
                });
            }

            function applyTheme(theme) {
                localStorage.setItem('theme', theme);
                var isDark =
                    theme === 'dark' ||
                    (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (isDark) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
                updateThemeUI(theme);
            }

            document.addEventListener('DOMContentLoaded', function () {
                var storedTheme = localStorage.getItem('theme') || 'system';
                updateThemeUI(storedTheme);

                var buttons = document.querySelectorAll('[data-theme-btn]');
                buttons.forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var val = btn.getAttribute('data-theme-btn');
                        if (val) {
                            applyTheme(val);
                        }
                    });
                });

                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
                    var currentStored = localStorage.getItem('theme') || 'system';
                    if (currentStored === 'system') {
                        if (e.matches) {
                            document.documentElement.classList.add('dark');
                        } else {
                            document.documentElement.classList.remove('dark');
                        }
                    }
                });
            });
        })();
    </script>
</body>
</html>
