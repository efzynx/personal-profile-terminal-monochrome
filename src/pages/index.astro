---
export const prerender = false;
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProfileData } from "../lib/cms";

const profileData = await getProfileData();
---


<BaseLayout
    title="Home"
    description={`${profileData.name} — ${profileData.title}`}
    breadcrumb="cd ~/"
>
    <div class="flex items-center justify-center min-h-[80vh]">
        <div
            class="w-full max-w-md border border-muted p-6 md:p-8 flex flex-col gap-6"
        >
            <!-- Header / Identity -->
            <div
                class="flex flex-col md:flex-row gap-6 items-start md:items-center"
            >
                <!-- Avatar -->
                <div
                    class="w-20 h-20 shrink-0 border border-muted overflow-hidden bg-background grayscale contrast-125 brightness-90 hover:grayscale-0 transition-all duration-300"
                >
                    <img
                        src={profileData.avatarUrl || "/saya.avif"}
                        alt={profileData.name}
                        class="w-full h-full object-cover"
                        loading="eager"
                        width="80"
                        height="80"
                    />
                </div>
                <!-- Identity Text -->
                <div class="flex flex-col gap-3">
                    <p class="font-mono text-sm text-accent">
                        {profileData.terminalPrompt || "fauzan@tux"}:~$ <span class="text-primary">whoami</span>
                    </p>

                    <h1
                        class="font-mono text-xl font-bold text-primary leading-snug"
                    >
                        {profileData.name}<span
                            class="inline-block w-2 h-5 bg-primary align-middle ml-1 animate-pulse"
                        ></span>
                    </h1>
                    <p
                        class="font-sans text-sm text-accent leading-relaxed whitespace-pre-line"
                    >
                        {profileData.bio}
                    </p>
                </div>
            </div>

            <!-- Divider -->
            <hr class="border-muted" />

            <!-- Navigation Menu -->
            <nav class="flex flex-col gap-0.5" aria-label="Main navigation">
                <a
                    id="nav-portfolio"
                    href="/portfolio"
                    class="group flex items-center h-10 px-3 hover:bg-surface transition-colors duration-0 cursor-[crosshair]"
                >
                    <span
                        class="font-mono text-accent mr-3 group-hover:text-primary"
                        >&gt;</span
                    >
                    <span
                        class="font-mono text-sm text-text group-hover:text-primary"
                        >portfolio/</span
                    >
                </a>
                <a
                    id="nav-blog"
                    href="/blog"
                    class="group flex items-center h-10 px-3 hover:bg-surface transition-colors duration-0 cursor-[crosshair]"
                >
                    <span
                        class="font-mono text-accent mr-3 group-hover:text-primary"
                        >&gt;</span
                    >
                    <span
                        class="font-mono text-sm text-text group-hover:text-primary"
                        >blog/</span
                    >
                </a>
                <a
                    id="nav-news"
                    href="/news"
                    class="group flex items-center h-10 px-3 hover:bg-surface transition-colors duration-0 cursor-[crosshair]"
                >
                    <span
                        class="font-mono text-accent mr-3 group-hover:text-primary"
                        >&gt;</span
                    >
                    <span
                        class="font-mono text-sm text-text group-hover:text-primary"
                        >news/</span
                    >
                </a>
                <a
                    id="nav-project"
                    href="/project"
                    class="group flex items-center h-10 px-3 hover:bg-surface transition-colors duration-0 cursor-[crosshair]"
                >
                    <span
                        class="font-mono text-accent mr-3 group-hover:text-primary"
                        >&gt;</span
                    >
                    <span
                        class="font-mono text-sm text-text group-hover:text-primary"
                        >project/</span
                    >
                </a>
                <a
                    id="nav-sosmed"
                    href="/sosmed"
                    class="group flex items-center h-10 px-3 hover:bg-surface transition-colors duration-0 cursor-[crosshair]"
                >
                    <span
                        class="font-mono text-accent mr-3 group-hover:text-primary"
                        >&gt;</span
                    >
                    <span
                        class="font-mono text-sm text-text group-hover:text-primary"
                        >sosmed/</span
                    >
                </a>
                <a
                    id="nav-writer"
                    href="/writer"
                    class="group flex items-center h-10 px-3 hover:bg-surface transition-colors duration-0 cursor-[crosshair]"
                >
                    <span
                        class="font-mono text-muted mr-3 group-hover:text-accent"
                        >&gt;</span
                    >
                    <span
                        class="font-mono text-xs text-muted group-hover:text-accent"
                        >settings/</span
                    >
                </a>
            </nav>

            <!-- Status Bar -->
            <div
                class="border-t border-muted pt-3 text-xs font-mono text-muted"
            >
                <span>© {new Date().getFullYear()} · built with astro</span>
            </div>
        </div>
    </div>
</BaseLayout>
