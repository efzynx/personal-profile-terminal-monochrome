---
/**
 * SEO.astro
 * Komponen sentral untuk technical SEO: Canonical URL, Meta Robots,
 * Open Graph, Twitter Card, theme-color, dan Schema.org JSON-LD Structured Data.
 */
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  articlePublishedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
  schemaJsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description = "Ahmad Fauzan Adiman — Backend Developer & DevOps Enthusiast",
  canonicalUrl,
  ogType = 'website',
  ogImage,
  articlePublishedTime,
  articleAuthor = "Ahmad Fauzan Adiman",
  articleTags = [],
  schemaJsonLd,
} = Astro.props;

const siteBase = process.env.PUBLIC_SITE_URL && !process.env.PUBLIC_SITE_URL.includes('localhost')
  ? process.env.PUBLIC_SITE_URL.replace(/\/$/, '')
  : 'https://www.efzyn.my.id';

const pathname = Astro.url.pathname;
const defaultCanonical = pathname === '/'
  ? `${siteBase}/`
  : `${siteBase}${pathname.replace(/\/$/, '')}`;
const canonicalURL = canonicalUrl || defaultCanonical;

// Format absolute Open Graph image URL
const rawImage = ogImage || (ogType === 'article' || pathname.startsWith('/news') || pathname.startsWith('/blog') ? '/banner.png' : '/saya.avif');
const fullOgImage = rawImage.startsWith('http://') || rawImage.startsWith('https://')
  ? rawImage
  : `${siteBase}${rawImage.startsWith('/') ? '' : '/'}${rawImage}`;

const fullTitle = title.includes('Ahmad Fauzan Adiman')
  ? title
  : `${title} — Ahmad Fauzan Adiman`;

// Default Schema.org Person & WebSite
const defaultPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteBase}/#person`,
  "name": "Ahmad Fauzan Adiman",
  "url": siteBase,
  "jobTitle": "Backend Developer & DevOps Enthusiast",
  "image": `${siteBase}/saya.avif`,
  "description": "Backend Developer & DevOps Enthusiast. Mahasiswa tingkat akhir Univ. Nurul Jadid.",
  "sameAs": [
    "https://github.com/efzynx",
    "https://linkedin.com/in/efzyn",
    "https://instagram.com/efzyn_",
    "https://tiktok.com/@efzynx",
    "https://youtube.com/@efzynx"
  ]
};

const defaultWebSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteBase}/#website`,
  "url": siteBase,
  "name": "Ahmad Fauzan Adiman — Terminal Monochrome",
  "description": description,
  "publisher": {
    "@id": `${siteBase}/#person`
  }
};

let finalSchema: any;
if (schemaJsonLd) {
  finalSchema = schemaJsonLd;
} else if (pathname === '/' || pathname === '/portfolio') {
  finalSchema = [defaultWebSiteSchema, defaultPersonSchema];
} else {
  finalSchema = defaultWebSiteSchema;
}
---

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Meta Robots Default -->
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="googlebot" content="index, follow, max-image-preview:large" />

<!-- Mobile Theme Color -->
<meta name="theme-color" content="#0a0a0a" />

<!-- Open Graph Meta Tags -->
<meta property="og:site_name" content="Ahmad Fauzan Adiman — Terminal Monochrome" />
<meta property="og:locale" content="id_ID" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={fullOgImage} />

{ogType === 'article' && articlePublishedTime && (
  <meta property="article:published_time" content={articlePublishedTime} />
)}
{ogType === 'article' && articleAuthor && (
  <meta property="article:author" content={articleAuthor} />
)}
{ogType === 'article' && articleTags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />

<!-- Structured Data (Schema.org JSON-LD) -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(finalSchema)} />
