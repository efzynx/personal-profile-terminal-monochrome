---
import { getProfileData } from "../lib/cms";
import { optimizeOgImageUrl } from "../lib/utils";

/**
 * SEO.astro
 * Komponen sentral untuk technical SEO: Canonical URL, Meta Robots,
 * Open Graph, Twitter Card, theme-color, Dynamic Favicon, dan Schema.org JSON-LD.
 */
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  articlePublishedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
  schemaJsonLd?: Record<string, any> | Array<Record<string, any>>;
  faviconUrl?: string;
  avatarUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Ahmad Fauzan Adiman — Backend Developer & DevOps Enthusiast",
  canonicalUrl,
  ogType = 'website',
  ogImage,
  articlePublishedTime,
  articleAuthor = "Ahmad Fauzan Adiman",
  articleTags = [],
  schemaJsonLd,
  faviconUrl,
  avatarUrl,
  noindex = false,
} = Astro.props;

const siteBase = process.env.PUBLIC_SITE_URL && !process.env.PUBLIC_SITE_URL.includes('localhost')
  ? process.env.PUBLIC_SITE_URL.replace(/\/$/, '')
  : 'https://www.efzyn.my.id';

const pathname = Astro.url.pathname;
const defaultCanonical = pathname === '/'
  ? `${siteBase}/`
  : `${siteBase}${pathname.replace(/\/$/, '')}`;
const canonicalURL = canonicalUrl || defaultCanonical;

// Ambil profileData jika avatarUrl atau faviconUrl belum disediakan
const profile = (avatarUrl && faviconUrl) ? null : await getProfileData();
const resolvedAvatar = avatarUrl || profile?.avatarUrl || '/saya.avif';
const resolvedFavicon = faviconUrl || profile?.faviconUrl || '/favicon.svg';

// Format absolute URLs
const fullAvatarUrl = resolvedAvatar.startsWith('http://') || resolvedAvatar.startsWith('https://')
  ? resolvedAvatar
  : `${siteBase}${resolvedAvatar.startsWith('/') ? '' : '/'}${resolvedAvatar}`;

const fullFaviconUrl = resolvedFavicon.startsWith('http://') || resolvedFavicon.startsWith('https://')
  ? resolvedFavicon
  : `${siteBase}${resolvedFavicon.startsWith('/') ? '' : '/'}${resolvedFavicon}`;

const isSvgFavicon = resolvedFavicon.endsWith('.svg');

// Format absolute Open Graph image URL dinamis:
// Jika artikel atau katalog berita/blog tanpa cover spesifik -> gunakan banner /banner.png
// Jika halaman utama / profil -> gunakan avatar aktif dari database/settings Supabase (fullAvatarUrl)
const defaultDynamicImage = (ogType === 'article' || pathname.startsWith('/news') || pathname.startsWith('/blog'))
  ? `${siteBase}/banner.png`
  : fullAvatarUrl;

const rawImage = ogImage || defaultDynamicImage;
const fullOgImage = optimizeOgImageUrl(rawImage, siteBase);

const secureOgImage = fullOgImage.startsWith('https://')
  ? fullOgImage
  : fullOgImage.replace(/^http:\/\//, 'https://');

const isProxiedByWsrv = fullOgImage.includes('wsrv.nl');
const cleanImgPath = fullOgImage.split('?')[0].toLowerCase();
const ogImageMime = isProxiedByWsrv
  ? 'image/jpeg'
  : cleanImgPath.endsWith('.png')
    ? 'image/png'
    : cleanImgPath.endsWith('.webp')
      ? 'image/webp'
      : cleanImgPath.endsWith('.gif')
        ? 'image/gif'
        : 'image/jpeg';

const fullTitle = title.includes('Ahmad Fauzan Adiman')
  ? title
  : `${title} — Ahmad Fauzan Adiman`;

// Default Schema.org Person & WebSite
const defaultPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteBase}/#person`,
  "name": profile?.name || "Ahmad Fauzan Adiman",
  "url": siteBase,
  "jobTitle": profile?.title || "Backend Developer & DevOps Enthusiast",
  "image": fullAvatarUrl,
  "description": profile?.bio || "Backend Developer & DevOps Enthusiast. Mahasiswa tingkat akhir Univ. Nurul Jadid.",
  "sameAs": [
    "https://github.com/efzynx",
    "https://linkedin.com/in/efzyn",
    "https://instagram.com/efzyn_",
    "https://tiktok.com/@efzynx",
    "https://youtube.com/@efzynx"
  ]
};

const defaultWebSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteBase}/#website`,
  "url": siteBase,
  "name": "Ahmad Fauzan Adiman — Terminal Monochrome",
  "description": description,
  "publisher": {
    "@id": `${siteBase}/#person`
  }
};

// --- Schema.org BreadcrumbList Generator ---
const cleanPath = pathname.replace(/\/$/, '');
const segments = cleanPath ? cleanPath.split('/').filter(Boolean) : [];

const segmentNameMap: Record<string, string> = {
  blog: 'Blog',
  news: 'News',
  portfolio: 'Portfolio',
  project: 'Projects',
  github: 'GitHub',
  sosmed: 'Sosmed',
  writer: 'Writer',
  dashboard: 'Dashboard',
  editor: 'Editor',
  settings: 'Settings',
  profile: 'Profile',
  '404': '404 Not Found',
};

const breadcrumbElements: Array<{ '@type': string; position: number; name: string; item: string }> = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: `${siteBase}/`,
  },
];

if (segments.length > 0) {
  let accumulatedPath = '';
  let currentPosition = 2;

  for (let i = 0; i < segments.length; i++) {
    const seg = segments[i];
    const isLeaf = i === segments.length - 1;

    // Khusus rute /blog/posts/:id -> lewati segmen internal 'posts' agar struktur skema: Home -> Blog -> Judul Artikel
    if (seg === 'posts' && i > 0 && segments[i - 1] === 'blog') {
      accumulatedPath += `/${seg}`;
      continue;
    }

    accumulatedPath += `/${seg}`;

    let itemName = '';
    if (isLeaf) {
      const cleanLeafTitle = title.replace(/\s*—\s*Ahmad Fauzan Adiman.*$/i, '').trim();
      itemName = cleanLeafTitle || segmentNameMap[seg] || (seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' '));
    } else {
      itemName = segmentNameMap[seg] || (seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' '));
    }

    const itemUrl = isLeaf ? canonicalURL : `${siteBase}${accumulatedPath}`;

    breadcrumbElements.push({
      '@type': 'ListItem',
      position: currentPosition++,
      name: itemName,
      item: itemUrl,
    });
  }
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbElements,
};

let finalSchema: any;
if (schemaJsonLd) {
  finalSchema = schemaJsonLd;
} else if (pathname === '/' || pathname === '/portfolio') {
  finalSchema = [defaultWebSiteSchema, defaultPersonSchema];
} else {
  finalSchema = defaultWebSiteSchema;
}

// Gabungkan skema BreadcrumbList bersama skema yang sudah ada
const schemaList = Array.isArray(finalSchema) ? [...finalSchema] : [finalSchema];
const alreadyHasBreadcrumb = schemaList.some(
  (s) => s && (s['@type'] === 'BreadcrumbList' || (Array.isArray(s['@type']) && s['@type'].includes('BreadcrumbList')))
);
if (!alreadyHasBreadcrumb) {
  schemaList.push(breadcrumbSchema);
}

// Pastikan skema artikel/posting yang memiliki properti `image` dioptimasi
schemaList.forEach((s) => {
  if (s && typeof s === 'object' && typeof s.image === 'string') {
    const type = s['@type'];
    if (type === 'BlogPosting' || type === 'NewsArticle' || type === 'Article') {
      s.image = optimizeOgImageUrl(s.image, siteBase);
    }
  }
});

finalSchema = schemaList.length === 1 ? schemaList[0] : schemaList;
---

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Meta Robots -->
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
<meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />

<!-- Mobile Theme Color -->
<meta name="theme-color" content="#0a0a0a" />

<!-- Dynamic Favicon from Supabase / Fallback -->
{isSvgFavicon ? (
  <link rel="icon" type="image/svg+xml" href={fullFaviconUrl} />
) : (
  <link rel="icon" href={fullFaviconUrl} />
)}
<link rel="shortcut icon" href={fullFaviconUrl} />
<link rel="apple-touch-icon" href={fullFaviconUrl} />

<!-- Open Graph Meta Tags -->
<meta property="og:site_name" content="Ahmad Fauzan Adiman — Terminal Monochrome" />
<meta property="og:locale" content="id_ID" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:secure_url" content={secureOgImage} />
<meta property="og:image:type" content={ogImageMime} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />

{ogType === 'article' && articlePublishedTime && (
  <meta property="article:published_time" content={articlePublishedTime} />
)}
{ogType === 'article' && articleAuthor && (
  <meta property="article:author" content={articleAuthor} />
)}
{ogType === 'article' && articleTags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:image:alt" content={fullTitle} />

<!-- Structured Data (Schema.org JSON-LD) -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(finalSchema)} />
